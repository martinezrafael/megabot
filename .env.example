# ===================================
# AMBIENTE LOCAL - MEGABOT
# ===================================

# App Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://megabot_app:megabot_pass@localhost:5432/megabot?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=megabot
POSTGRES_PORT=5432

# Autenticação (Better Auth) - API NestJS em PORT, web (Next.js) em 3001
# Gere com: openssl rand -base64 32  (a API NÃO sobe com o valor de exemplo)
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Login com Google (opcional: sem estas duas variáveis o botão fica desativado)
# Crie em https://console.cloud.google.com/apis/credentials (veja o README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (em dev usa o Mailpit do docker compose; caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Megabot <no-reply@megabot.local>"
# SMTP_USER=
# SMTP_PASS=

# Observabilidade: logs estruturados (pino). Níveis: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Rate limit por IP. A janela é em segundos; AUTH_MAX vale para login, cadastro e reset de senha.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# Atrás de proxy/load balancer: número de proxies confiáveis (ex.: 1). Em desenvolvimento, deixe false.
TRUST_PROXY=false

# Documentação interativa em /docs (padrão: ligada em desenvolvimento, desligada em produção)
# SWAGGER_ENABLED=true

# Web (Next.js): URL da API vista pelo SERVIDOR do Next (rede interna). Se vazia, usa NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3000

# Fila / Redis (se utilizar para filas) ou Drizzle / BullMQ
# REDIS_URL=redis://localhost:6379

# Webhooks / Local Tunnel (ngrok / localtunnel)
WEBHOOK_BASE_URL=https://seu-subdominio.ngrok-free.app

# API Keys & Third-party Services (Preencha com suas chaves de dev)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx