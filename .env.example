# ===================================
# AMBIENTE LOCAL - MEGABOT
# ===================================

# App Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megabot?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=megabot
POSTGRES_PORT=5432

# Fila / Redis (se utilizar para filas) ou Drizzle / BullMQ
# REDIS_URL=redis://localhost:6379

# Webhooks / Local Tunnel (ngrok / localtunnel)
WEBHOOK_BASE_URL=https://seu-subdominio.ngrok-free.app

# API Keys & Third-party Services (Preencha com suas chaves de dev)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx