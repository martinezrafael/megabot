         run: pnpm test
 
       # Os rollbacks devem ser aplicados na ORDEM INVERSA das migrations.
+      - name: Verify knowledge base migration rollback
+        run: |
+          psql "$APP_PG_URL" -v ON_ERROR_STOP=1 \
+            -f packages/database/prisma/migrations/20261121120000_knowledge_base/rollback.sql
+          TABLES=$(psql "$APP_PG_URL" -tAc "SELECT count(*) FROM information_schema.tables WHERE table_name IN ('knowledge_sources','knowledge_chunks')")
+          test "$TABLES" = "0"
+
       - name: Verify WhatsApp token envelope migration rollback
         run: |
           psql "$APP_PG_URL" -v ON_ERROR_STOP=1 \
