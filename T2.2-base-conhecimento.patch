+/**
+ * Erros da ingestão. O `code` vai para `knowledge_sources.error_code` e a `message` aparece NA TELA
+ * para o cliente: por isso ela é em português, explica o que aconteceu e diz o que fazer.
+ * `retryable` diz se vale a pena o job tentar de novo (problema passageiro) ou não.
+ */
+export type KnowledgeErrorCode =
+  | 'formato_nao_suportado'
+  | 'documento_vazio'
+  | 'sem_texto'
+  | 'arquivo_grande'
+  | 'pdf_invalido'
+  | 'planilha_invalida'
+  | 'url_invalida'
+  | 'url_bloqueada'
+  | 'url_inacessivel'
+  | 'url_erro_http'
+  | 'arquivo_ausente';
+
+export class KnowledgeError extends Error {
+  constructor(
+    readonly code: KnowledgeErrorCode,
+    message: string,
+    readonly retryable = false,
+    options: { cause?: unknown } = {},
+  ) {
+    super(message, options.cause === undefined ? undefined : { cause: options.cause });
+    this.name = 'KnowledgeError';
+  }
+}
+
+export const knowledgeError = (
+  code: KnowledgeErrorCode,
+  message: string,
+  retryable = false,
+  cause?: unknown,
+) => new KnowledgeError(code, message, retryable, cause === undefined ? {} : { cause });
diff --git a/packages/knowledge/src/extract/html.ts b/packages/knowledge/src/extract/html.ts
new file mode 100644
index 0000000..0fe3e46
--- /dev/null
+++ b/packages/knowledge/src/extract/html.ts
@@ -0,0 +1,163 @@
+import { load, type Cheerio, type CheerioAPI } from 'cheerio';
+import type { AnyNode } from 'domhandler';
+
+/**
+ * HTML -> texto em "markdown simples": `#`/`##`/`###` para títulos, parágrafos separados por linha
+ * em branco, `- ` para itens de lista e `|` entre células de tabela. É esse formato que o divisor
+ * de trechos (chunk.ts) entende para saber de qual seção cada trecho veio.
+ *
+ * Também joga fora o que não é conteúdo (menus, rodapés, scripts, formulários) e, quando a página
+ * marca o conteúdo principal com <main> ou <article>, lê só essa parte.
+ */
+
+/** Removidos antes de qualquer leitura: não são conteúdo ou são barulho de navegação. */
+const DROP =
+  'script,style,noscript,template,svg,canvas,iframe,form,button,select,nav,footer,aside,[role=navigation],[role=banner],[role=contentinfo],[aria-hidden=true]';
+
+const HEADINGS: Record<string, string> = {
+  h1: '#',
+  h2: '##',
+  h3: '###',
+  h4: '###',
+  h5: '###',
+  h6: '###',
+};
+const BLOCKS = new Set([
+  'p',
+  'div',
+  'section',
+  'article',
+  'main',
+  'header',
+  'ul',
+  'ol',
+  'dl',
+  'dt',
+  'dd',
+  'blockquote',
+  'pre',
+  'figure',
+  'figcaption',
+  'table',
+  'thead',
+  'tbody',
+  'tfoot',
+  'address',
+  'hr',
+  'details',
+  'summary',
+  'h1',
+  'h2',
+  'h3',
+  'h4',
+  'h5',
+  'h6',
+]);
+
+export interface HtmlExtraction {
+  text: string;
+  /** <title> da página (ou o primeiro <h1>), já limpo. */
+  title: string | null;
+}
+
+export function htmlToText(html: string): HtmlExtraction {
+  const $ = load(html);
+  $(DROP).remove();
+
+  const title = clean($('head > title').first().text()) || clean($('h1').first().text()) || null;
+
+  const main = $('main').first();
+  const article = $('article').first();
+  const root: Cheerio<AnyNode> = main.length
+    ? main
+    : article.length
+      ? article
+      : $('body').length
+        ? $('body')
+        : $.root();
+
+  const out: string[] = [];
+  for (const node of root.contents().toArray()) walk($, node, out);
+
+  return { text: normalize(out.join('')), title };
+}
+
+const clean = (value: string): string => value.replace(/\s+/g, ' ').trim();
+
+function walk($: CheerioAPI, node: AnyNode, out: string[]): void {
+  if (node.type === 'text') {
+    out.push(node.data.replace(/\s+/g, ' '));
+    return;
+  }
+  if (node.type !== 'tag') return;
+  const tag = node.tagName.toLowerCase();
+
+  if (tag === 'br') return void out.push('\n');
+  if (tag === 'hr') return void out.push('\n\n');
+  if (tag === 'img') {
+    // O texto alternativo costuma ser a única descrição da imagem.
+    const alt = clean($(node).attr('alt') ?? '');
+    if (alt) out.push(`\n${alt}\n`);
+    return;
+  }
+
+  const heading = HEADINGS[tag];
+  if (heading) {
+    const text = clean($(node).text());
+    if (text) out.push(`\n\n${heading} ${text}\n\n`);
+    return;
+  }
+
+  if (tag === 'pre') {
+    // Em <pre> as QUEBRAS DE LINHA são conteúdo (código, endereço, horários), por isso são mantidas.
+    // A indentação, não: ela é normalizada como no resto do texto (não ajuda a busca por similaridade).
+    const text = $(node)
+      .text()
+      .replace(/\r\n?/g, '\n')
+      .replace(/[ \t]+$/gm, '');
+    if (text.trim()) out.push(`\n\n${text.trim()}\n\n`);
+    return;
+  }
+
+  if (tag === 'li') {
+    // Só a quebra de abertura: o próximo item traz a sua, e assim a lista não ganha linhas vazias.
+    out.push('\n- ');
+    for (const child of $(node).contents().toArray()) walk($, child, out);
+    return;
+  }
+
+  if (tag === 'tr') {
+    const cells = $(node)
+      .children('th,td')
+      .toArray()
+      .map((cell) => clean($(cell).text()))
+      .filter((cell) => cell.length > 0);
+    // Igual à lista: só a quebra de abertura, para as linhas da tabela ficarem juntas.
+    if (cells.length) out.push(`\n${cells.join(' | ')}`);
+    return;
+  }
+
+  const isBlock = BLOCKS.has(tag);
+  if (isBlock) out.push('\n\n');
+  for (const child of $(node).contents().toArray()) walk($, child, out);
+  if (isBlock) out.push('\n\n');
+}
+
+/** Tira espaços repetidos, limita a 1 linha em branco entre blocos e remove linhas vazias. */
+function normalize(raw: string): string {
+  const lines = raw
+    .replace(/\r\n?/g, '\n')
+    .split('\n')
+    .map((line) => line.replace(/[ \t]+/g, ' ').trim());
+
+  const result: string[] = [];
+  for (const line of lines) {
+    if (line === '') {
+      if (result.length > 0 && result[result.length - 1] !== '') result.push('');
+      continue;
+    }
+    result.push(line);
+  }
+  while (result.length && result[result.length - 1] === '') result.pop();
+  return result.join('\n');
+}
diff --git a/packages/knowledge/src/extract/index.ts b/packages/knowledge/src/extract/index.ts
new file mode 100644
index 0000000..ef7894c
--- /dev/null
+++ b/packages/knowledge/src/extract/index.ts
@@ -0,0 +1,121 @@
+import { knowledgeError } from '../errors';
+import { normalizeMimeType, type DocumentFormat } from '../formats';
+import { htmlToText } from './html';
+import { pdfToText } from './pdf';
+import { delimitedToText, xlsxToText } from './sheet';
+
+export interface ExtractInput {
+  bytes: Uint8Array;
+  format: DocumentFormat;
+  /** Usado só em mensagens e no rótulo das planilhas. */
+  fileName?: string | null;
+  /** Charset declarado pelo servidor (`text/html; charset=...`), quando houver. */
+  charset?: string | null;
+}
+
+export interface ExtractedDocument {
+  /** Texto em "markdown simples" (ver html.ts): é a entrada do divisor de trechos. */
+  text: string;
+  format: DocumentFormat;
+  title: string | null;
+  pageCount: number | null;
+  sheetNames: string[];
+  /** Avisos que não impedem a ingestão (ex.: planilha truncada). */
+  warnings: string[];
+}
+
+/** Charset declarado no HTML (`<meta charset=...>`), para páginas antigas em latin-1. */
+function charsetFromHtml(bytes: Uint8Array): string | null {
+  const head = Buffer.from(bytes.subarray(0, 2048)).toString('latin1');
+  const match =
+    /<meta[^>]+charset\s*=\s*["']?\s*([\w-]+)/i.exec(head) ??
+    /<\?xml[^>]+encoding\s*=\s*["']([\w-]+)/i.exec(head);
+  return match?.[1] ?? null;
+}
+
+/**
+ * Bytes -> string. Tenta UTF-8 de verdade (modo estrito) e, se os bytes não forem UTF-8 válido,
+ * cai para windows-1252 (o que páginas e CSVs antigos do Brasil costumam usar). Assim "ç" e "ã"
+ * não viram "�".
+ */
+export function decodeText(bytes: Uint8Array, declaredCharset?: string | null): string {
+  const normalized = (declaredCharset ?? '').trim().toLowerCase();
+  const candidates = [
+    ...(normalized && normalized !== 'utf-8' && normalized !== 'utf8' ? [normalized] : []),
+    'utf-8',
+    'windows-1252',
+  ];
+  for (const charset of candidates) {
+    try {
+      return new TextDecoder(charset, { fatal: true }).decode(bytes).replace(/^\uFEFF/, '');
+    } catch {
+      // charset desconhecido ou bytes inválidos: tenta o próximo
+    }
+  }
+  // Último recurso: UTF-8 tolerante (troca o que não entender por "�").
+  return new TextDecoder('utf-8').decode(bytes).replace(/^\uFEFF/, '');
+}
+
+/** Lê o documento e devolve o texto. Lança `KnowledgeError` com mensagem para o cliente. */
+export async function extractDocument(input: ExtractInput): Promise<ExtractedDocument> {
+  const { bytes, format } = input;
+  if (bytes.byteLength === 0) {
+    throw knowledgeError('documento_vazio', 'O arquivo está vazio (0 byte).');
+  }
+
+  const base = { format, title: null, pageCount: null, sheetNames: [], warnings: [] };
+  let result: ExtractedDocument;
+
+  switch (format) {
+    case 'pdf': {
+      const { text, pageCount } = await pdfToText(bytes);
+      result = { ...base, text, pageCount };
+      break;
+    }
+    case 'html': {
+      const { text, title } = htmlToText(
+        decodeText(bytes, input.charset ?? charsetFromHtml(bytes)),
+      );
+      result = { ...base, text, title };
+      break;
+    }
+    case 'xlsx': {
+      const { text, sheetNames, warnings } = await xlsxToText(bytes);
+      result = { ...base, text, sheetNames, warnings };
+      break;
+    }
+    case 'csv':
+    case 'tsv': {
+      const label = input.fileName ?? 'Planilha';
+      const { text, warnings } = delimitedToText(
+        decodeText(bytes, input.charset),
+        format === 'csv' ? ',' : '\t',
+        label,
+      );
+      result = { ...base, text, warnings };
+      break;
+    }
+    case 'text':
+    case 'markdown': {
+      const decoded = decodeText(bytes, input.charset)
+        .replace(/\r\n?/g, '\n')
+        .replace(/[ \t]+$/gm, '')
+        .trim();
+      result = { ...base, text: decoded };
+      break;
+    }
+  }
+
+  if (result.text.trim().length === 0) {
+    throw knowledgeError(
+      'sem_texto',
+      format === 'pdf'
+        ? 'Este PDF não tem texto: parece ser um documento escaneado (imagem). ' +
+            'Envie uma versão com texto selecionável ou passe o conteúdo em .txt.'
+        : 'Não encontrei texto neste documento.',
+    );
+  }
+  return result;
+}
+
+export { htmlToText, pdfToText, xlsxToText, delimitedToText, normalizeMimeType };
diff --git a/packages/knowledge/src/extract/pdf.ts b/packages/knowledge/src/extract/pdf.ts
new file mode 100644
index 0000000..4096b7b
--- /dev/null
+++ b/packages/knowledge/src/extract/pdf.ts
@@ -0,0 +1,38 @@
+import { knowledgeError } from '../errors';
+
+export interface PdfExtraction {
+  text: string;
+  pageCount: number;
+}
+
+/**
+ * PDF -> texto, página por página (cada página virando a seção `## Página N`, que o divisor de
+ * trechos usa como referência: dá para dizer ao cliente "isto veio da página 3").
+ *
+ * Usa o unpdf (pdf.js empacotado para Node). PDF que é só imagem (documento escaneado) não tem
+ * texto para extrair: isso vira o erro `sem_texto`, com a explicação de que falta OCR.
+ */
+export async function pdfToText(bytes: Uint8Array): Promise<PdfExtraction> {
+  const { extractText, getDocumentProxy } = await import('unpdf');
+  let pages: string[];
+  try {
+    // O pdf.js pode ficar com o buffer; passar uma copia evita surpresa para quem chamou.
+    const pdf = await getDocumentProxy(new Uint8Array(bytes));
+    const extracted = await extractText(pdf, { mergePages: false });
+    pages = Array.isArray(extracted.text) ? extracted.text : [extracted.text];
+  } catch (error) {
+    throw knowledgeError(
+      'pdf_invalido',
+      'Não foi possível ler este PDF. Ele pode estar corrompido ou protegido por senha.',
+      false,
+      error,
+    );
+  }
+
+  const sections = pages
+    .map((page, index) => ({ page: index + 1, text: page.replace(/\r\n?/g, '\n').trim() }))
+    .filter((section) => section.text.length > 0)
+    .map((section) => `## Página ${section.page}\n\n${section.text}`);
+
+  return { text: sections.join('\n\n'), pageCount: pages.length };
+}
diff --git a/packages/knowledge/src/extract/sheet.ts b/packages/knowledge/src/extract/sheet.ts
new file mode 100644
index 0000000..8de9a93
--- /dev/null
+++ b/packages/knowledge/src/extract/sheet.ts
@@ -0,0 +1,146 @@
+import ExcelJS from 'exceljs';
+import { knowledgeError } from '../errors';
+
+/**
+ * Planilhas -> texto. Cada aba vira a seção `## Aba: <nome>` e cada linha vira uma frase
+ * `Coluna: valor | Coluna: valor`, usando a primeira linha como cabeçalho.
+ *
+ * Por que assim: um trecho precisa fazer sentido sozinho para o agente responder. "79,90" não diz
+ * nada; "SKU: CAM-001 | Nome: Camiseta preta | Preço: 79.9" responde "quanto custa a camiseta?".
+ */
+
+/** Teto de linhas por aba: planilha gigante viraria uma base inútil (e caríssima de embeddar). */
+export const MAX_SHEET_ROWS = 5000;
+
+export interface SheetExtraction {
+  text: string;
+  sheetNames: string[];
+  warnings: string[];
+}
+
+const cellToText = (value: unknown): string => {
+  if (value === null || value === undefined) return '';
+  if (value instanceof Date) return value.toISOString().slice(0, 10);
+  if (typeof value === 'object') {
+    const rich = value as { text?: unknown; result?: unknown; hyperlink?: unknown };
+    if (typeof rich.text === 'string') return rich.text.trim();
+    if (rich.result !== undefined && rich.result !== null) return String(rich.result).trim();
+    if (typeof rich.hyperlink === 'string') return rich.hyperlink.trim();
+    return '';
+  }
+  return String(value).trim();
+};
+
+function rowsToText(rows: string[][], warnings: string[], label: string): string {
+  const nonEmpty = rows.filter((row) => row.some((cell) => cell !== ''));
+  if (nonEmpty.length === 0) return '';
+
+  const [header, ...body] = nonEmpty;
+  const headers = (header ?? []).map((cell) => cell.trim());
+  // Sem corpo, a própria linha de cabeçalho é o conteúdo.
+  if (body.length === 0) return headers.filter(Boolean).join(' | ');
+
+  const limited = body.slice(0, MAX_SHEET_ROWS);
+  if (body.length > limited.length) {
+    warnings.push(
+      `${label}: só as primeiras ${MAX_SHEET_ROWS} linhas foram lidas (a planilha tem ${body.length}).`,
+    );
+  }
+
+  return limited
+    .map((row) =>
+      row
+        .map((cell, index) => {
+          if (cell === '') return '';
+          const name = headers[index];
+          return name ? `${name}: ${cell}` : cell;
+        })
+        .filter((part) => part !== '')
+        .join(' | '),
+    )
+    .filter((line) => line !== '')
+    .join('\n');
+}
+
+export async function xlsxToText(bytes: Uint8Array): Promise<SheetExtraction> {
+  const workbook = new ExcelJS.Workbook();
+  try {
+    // O ExcelJS espera um Buffer do Node.
+    await workbook.xlsx.load(Buffer.from(bytes) as unknown as ExcelJS.Buffer);
+  } catch (error) {
+    throw knowledgeError(
+      'planilha_invalida',
+      'Não foi possível ler esta planilha. Confira se o arquivo é .xlsx e não está corrompido.',
+      false,
+      error,
+    );
+  }
+
+  const warnings: string[] = [];
+  const sheetNames: string[] = [];
+  const sections: string[] = [];
+
+  workbook.eachSheet((sheet) => {
+    sheetNames.push(sheet.name);
+    const rows: string[][] = [];
+    sheet.eachRow({ includeEmpty: false }, (row) => {
+      const values = Array.isArray(row.values) ? row.values.slice(1) : [];
+      rows.push(values.map(cellToText));
+    });
+    const text = rowsToText(rows, warnings, `Aba "${sheet.name}"`);
+    if (text) sections.push(`## Aba: ${sheet.name}\n\n${text}`);
+  });
+
+  return { text: sections.join('\n\n'), sheetNames, warnings };
+}
+
+/**
+ * CSV/TSV -> texto. Parser próprio (poucas linhas) que entende aspas duplas, aspas escapadas
+ * (`""`), separador dentro de aspas e quebra de linha dentro de aspas.
+ */
+export function parseDelimited(content: string, delimiter: ',' | '\t'): string[][] {
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = '';
+  let quoted = false;
+
+  const endField = () => {
+    row.push(field.trim());
+    field = '';
+  };
+  const endRow = () => {
+    endField();
+    rows.push(row);
+    row = [];
+  };
+
+  const text = content.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n');
+  for (let i = 0; i < text.length; i += 1) {
+    const char = text[i]!;
+    if (quoted) {
+      if (char === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i += 1;
+        } else quoted = false;
+      } else field += char;
+      continue;
+    }
+    if (char === '"') quoted = true;
+    else if (char === delimiter) endField();
+    else if (char === '\n') endRow();
+    else field += char;
+  }
+  if (field !== '' || row.length > 0) endRow();
+  return rows;
+}
+
+export function delimitedToText(
+  content: string,
+  delimiter: ',' | '\t',
+  label = 'Planilha',
+): SheetExtraction {
+  const warnings: string[] = [];
+  const text = rowsToText(parseDelimited(content, delimiter), warnings, label);
+  return { text, sheetNames: [], warnings };
+}
diff --git a/packages/knowledge/src/fetch-url.ts b/packages/knowledge/src/fetch-url.ts
new file mode 100644
index 0000000..74c9e89
--- /dev/null
+++ b/packages/knowledge/src/fetch-url.ts
@@ -0,0 +1,277 @@
+import { lookup as dnsLookup } from 'node:dns/promises';
+import { knowledgeError } from './errors';
+import {
+  DEFAULT_MAX_BYTES,
+  detectFormat,
+  formatBytes,
+  normalizeMimeType,
+  type DocumentFormat,
+} from './formats';
+
+/**
+ * Importação por URL (a seção "Site da empresa" da tela).
+ *
+ * Aqui o servidor busca um endereço escolhido pelo cliente: é o caminho clássico de um ataque de
+ * SSRF ("faz o servidor buscar o que eu não alcanço"). Por isso:
+ *  - só http/https, sem usuário:senha na URL;
+ *  - o nome é RESOLVIDO e os IPs têm de ser públicos (bloqueia localhost, 10.x, 169.254.169.254...);
+ *  - redirecionamentos são seguidos à mão, revalidando cada salto;
+ *  - o download tem tempo máximo e tamanho máximo (corta no meio, sem carregar o resto).
+ *
+ * Limite conhecido: entre a checagem do IP e a conexão, o DNS pode mudar (DNS rebinding). Fechar
+ * isso exige conectar no IP já validado (ou um proxy de saída); está registrado na ADR 0020.
+ */
+
+export const DEFAULT_FETCH_TIMEOUT_MS = 15_000;
+const MAX_REDIRECTS = 3;
+
+export type LookupFn = (hostname: string) => Promise<Array<{ address: string; family: number }>>;
+
+export interface FetchRemoteOptions {
+  fetch?: typeof fetch;
+  lookup?: LookupFn;
+  maxBytes?: number;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+}
+
+export interface RemoteDocument {
+  bytes: Uint8Array;
+  /** Tipo declarado pelo servidor, sem parâmetros (`text/html`). */
+  mimeType: string;
+  charset: string | null;
+  format: DocumentFormat;
+  /** URL final, depois dos redirecionamentos. */
+  finalUrl: string;
+  fileName: string | null;
+}
+
+/** Valida a forma da URL (sintaxe, esquema, credenciais). Não resolve DNS. */
+export function assertHttpUrl(raw: string): URL {
+  let url: URL;
+  try {
+    url = new URL(raw.trim());
+  } catch {
+    throw knowledgeError(
+      'url_invalida',
+      `"${raw}" não é um endereço válido. Exemplo: https://suaempresa.com.br/sobre`,
+    );
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    throw knowledgeError('url_invalida', 'Use um endereço http:// ou https://.');
+  }
+  if (url.username || url.password) {
+    throw knowledgeError('url_invalida', 'Não aceitamos endereços com usuário e senha embutidos.');
+  }
+  if (!url.hostname) throw knowledgeError('url_invalida', 'O endereço não tem domínio.');
+  return url;
+}
+
+const BLOCKED_HOST_SUFFIXES = ['.localhost', '.local', '.internal', '.lan', '.home.arpa'];
+
+/** `true` para IPs que não devem ser alcançados a partir do servidor (rede interna, metadados...). */
+export function isPrivateAddress(address: string): boolean {
+  const value = address
+    .trim()
+    .toLowerCase()
+    .replace(/^\[|]$/g, '');
+
+  if (value.includes(':')) {
+    // IPv6. ::ffff:10.0.0.1 é um IPv4 disfarçado.
+    const mapped = /^::ffff:(\d+\.\d+\.\d+\.\d+)$/.exec(value);
+    if (mapped) return isPrivateAddress(mapped[1]!);
+    if (value === '::' || value === '::1') return true;
+    const head = value.split(':')[0] ?? '';
+    if (/^f[cd]/.test(head)) return true; // fc00::/7 (uso local)
+    if (/^fe[89ab]/.test(head)) return true; // fe80::/10 (link local)
+    return false;
+  }
+
+  const parts = value.split('.');
+  if (parts.length !== 4) return true; // formato estranho: trata como inseguro
+  const [a, b] = parts.map((part) => Number(part));
+  if (parts.some((part) => !/^\d{1,3}$/.test(part)) || a === undefined || b === undefined)
+    return true;
+  if (parts.some((part) => Number(part) > 255)) return true;
+
+  if (a === 0 || a === 10 || a === 127) return true;
+  if (a === 169 && b === 254) return true; // link local, inclui 169.254.169.254 (metadados de nuvem)
+  if (a === 172 && b >= 16 && b <= 31) return true;
+  if (a === 192 && b === 168) return true;
+  if (a === 100 && b >= 64 && b <= 127) return true; // CGNAT
+  if (a === 198 && (b === 18 || b === 19)) return true; // benchmark
+  if (a === 192 && b === 0) return true; // 192.0.0.0/24 e 192.0.2.0/24 (documentação)
+  if (a >= 224) return true; // multicast e reservados
+  return false;
+}
+
+/** Resolve o nome e exige que TODOS os IPs sejam públicos. */
+export async function assertPublicHost(url: URL, lookup: LookupFn = defaultLookup): Promise<void> {
+  const hostname = url.hostname.toLowerCase().replace(/^\[|]$/g, '');
+  if (hostname === 'localhost' || BLOCKED_HOST_SUFFIXES.some((s) => hostname.endsWith(s))) {
+    throw knowledgeError('url_bloqueada', 'Esse endereço aponta para a rede interna do servidor.');
+  }
+  // IP literal: nem precisa de DNS.
+  if (/^[\d.]+$/.test(hostname) || hostname.includes(':')) {
+    if (isPrivateAddress(hostname)) {
+      throw knowledgeError(
+        'url_bloqueada',
+        'Esse endereço aponta para a rede interna do servidor.',
+      );
+    }
+    return;
+  }
+
+  let addresses: Array<{ address: string; family: number }>;
+  try {
+    addresses = await lookup(hostname);
+  } catch {
+    throw knowledgeError(
+      'url_inacessivel',
+      `Não consegui encontrar o domínio "${hostname}". Confira o endereço.`,
+      true,
+    );
+  }
+  if (addresses.length === 0 || addresses.some((entry) => isPrivateAddress(entry.address))) {
+    throw knowledgeError('url_bloqueada', 'Esse endereço aponta para a rede interna do servidor.');
+  }
+}
+
+const defaultLookup: LookupFn = (hostname) => dnsLookup(hostname, { all: true, verbatim: true });
+
+function fileNameFromUrl(url: URL): string | null {
+  const last = url.pathname.split('/').filter(Boolean).pop();
+  return last && last.includes('.') ? decodeURIComponent(last) : null;
+}
+
+async function readWithLimit(response: Response, maxBytes: number): Promise<Uint8Array> {
+  const declared = Number(response.headers.get('content-length') ?? '');
+  if (Number.isFinite(declared) && declared > maxBytes) {
+    throw knowledgeError(
+      'arquivo_grande',
+      `A página tem ${formatBytes(declared)} e o limite é ${formatBytes(maxBytes)}.`,
+    );
+  }
+  if (!response.body) return new Uint8Array(await response.arrayBuffer());
+
+  const reader = response.body.getReader();
+  const parts: Uint8Array[] = [];
+  let total = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!value) continue;
+      total += value.byteLength;
+      if (total > maxBytes) {
+        throw knowledgeError(
+          'arquivo_grande',
+          `O conteúdo passou de ${formatBytes(maxBytes)}; o download foi interrompido.`,
+        );
+      }
+      parts.push(value);
+    }
+  } finally {
+    await reader.cancel().catch(() => undefined);
+  }
+
+  const bytes = new Uint8Array(total);
+  let offset = 0;
+  for (const part of parts) {
+    bytes.set(part, offset);
+    offset += part.byteLength;
+  }
+  return bytes;
+}
+
+/** Baixa o documento da URL, com todas as proteções acima. */
+export async function fetchRemoteDocument(
+  rawUrl: string,
+  options: FetchRemoteOptions = {},
+): Promise<RemoteDocument> {
+  const fetchImpl = options.fetch ?? fetch;
+  const lookup = options.lookup ?? defaultLookup;
+  const maxBytes = options.maxBytes ?? DEFAULT_MAX_BYTES;
+  const timeoutMs = options.timeoutMs ?? DEFAULT_FETCH_TIMEOUT_MS;
+
+  let url = assertHttpUrl(rawUrl);
+  let response: Response | undefined;
+
+  for (let hop = 0; hop <= MAX_REDIRECTS; hop += 1) {
+    await assertPublicHost(url, lookup);
+
+    const timeout = AbortSignal.timeout(timeoutMs);
+    const signal = options.signal ? AbortSignal.any([options.signal, timeout]) : timeout;
+    try {
+      response = await fetchImpl(url.toString(), {
+        redirect: 'manual',
+        signal,
+        headers: {
+          // Um user agent honesto: alguns sites bloqueiam quem não se identifica.
+          'user-agent': 'MegabotKnowledgeBot/1.0 (+https://megabot.app)',
+          accept: 'text/html,text/plain,application/pdf,text/csv,*/*;q=0.8',
+          'accept-language': 'pt-BR,pt;q=0.9,en;q=0.8',
+        },
+      });
+    } catch (error) {
+      if (options.signal?.aborted) throw error;
+      if (timeout.aborted) {
+        throw knowledgeError(
+          'url_inacessivel',
+          `O site não respondeu em ${Math.round(timeoutMs / 1000)} segundos. Tente de novo mais tarde.`,
+          true,
+          error,
+        );
+      }
+      throw knowledgeError(
+        'url_inacessivel',
+        'Não consegui acessar esse endereço. Confira se ele abre no navegador.',
+        true,
+        error,
+      );
+    }
+
+    const location = response.headers.get('location');
+    if (response.status >= 300 && response.status < 400 && location) {
+      if (hop === MAX_REDIRECTS) {
+        throw knowledgeError('url_inacessivel', 'O endereço tem redirecionamentos demais.');
+      }
+      try {
+        url = assertHttpUrl(new URL(location, url).toString());
+      } catch {
+        throw knowledgeError(
+          'url_invalida',
+          'O site redirecionou para um endereço que não sei abrir.',
+        );
+      }
+      continue;
+    }
+    break;
+  }
+
+  if (!response)
+    throw knowledgeError('url_inacessivel', 'Não consegui acessar esse endereço.', true);
+
+  if (!response.ok) {
+    const retryable = response.status === 429 || response.status >= 500;
+    throw knowledgeError(
+      'url_erro_http',
+      retryable
+        ? `O site respondeu ${response.status} (instável ou limitando acessos). Vamos tentar de novo.`
+        : `O site respondeu ${response.status}. Confira se o endereço está público (sem login).`,
+      retryable,
+    );
+  }
+
+  const contentType = response.headers.get('content-type');
+  const mimeType = normalizeMimeType(contentType) || 'text/html';
+  const charset = /charset\s*=\s*"?([\w-]+)/i.exec(contentType ?? '')?.[1] ?? null;
+  const fileName = fileNameFromUrl(url);
+  const format = detectFormat({ mimeType, fileName });
+  const bytes = await readWithLimit(response, maxBytes);
+
+  if (bytes.byteLength === 0) {
+    throw knowledgeError('documento_vazio', 'A página veio vazia.');
+  }
+  return { bytes, mimeType, charset, format, finalUrl: url.toString(), fileName };
+}
diff --git a/packages/knowledge/src/formats.ts b/packages/knowledge/src/formats.ts
new file mode 100644
index 0000000..e9fb9d7
--- /dev/null
+++ b/packages/knowledge/src/formats.ts
@@ -0,0 +1,123 @@
+import { KnowledgeError, knowledgeError } from './errors';
+
+/** Formatos que sabemos transformar em texto. */
+export type DocumentFormat = 'html' | 'pdf' | 'text' | 'markdown' | 'csv' | 'tsv' | 'xlsx';
+
+/** Tamanho máximo padrão de um documento (20 MB). Configurável pela API/worker. */
+export const DEFAULT_MAX_BYTES = 20 * 1024 * 1024;
+
+const BY_EXTENSION: Record<string, DocumentFormat> = {
+  htm: 'html',
+  html: 'html',
+  xhtml: 'html',
+  pdf: 'pdf',
+  txt: 'text',
+  text: 'text',
+  md: 'markdown',
+  markdown: 'markdown',
+  csv: 'csv',
+  tsv: 'tsv',
+  xlsx: 'xlsx',
+  xlsm: 'xlsx',
+};
+
+const BY_MIME: Record<string, DocumentFormat> = {
+  'text/html': 'html',
+  'application/xhtml+xml': 'html',
+  'application/pdf': 'pdf',
+  'text/plain': 'text',
+  'text/markdown': 'markdown',
+  'text/csv': 'csv',
+  'application/csv': 'csv',
+  'text/tab-separated-values': 'tsv',
+  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'xlsx',
+  'application/vnd.ms-excel.sheet.macroenabled.12': 'xlsx',
+};
+
+/** Formatos que o upload aceita, em texto, para mensagens de erro e para a tela. */
+export const SUPPORTED_UPLOAD_EXTENSIONS = [
+  '.pdf',
+  '.html',
+  '.txt',
+  '.md',
+  '.csv',
+  '.tsv',
+  '.xlsx',
+] as const;
+
+export const extensionOf = (fileName: string | undefined | null): string =>
+  fileName?.includes('.') ? (fileName.split('.').pop() ?? '').toLowerCase() : '';
+
+/** Tipo declarado sem os parâmetros (`text/html; charset=utf-8` -> `text/html`). */
+export const normalizeMimeType = (mimeType: string | undefined | null): string =>
+  (mimeType ?? '').split(';')[0]!.trim().toLowerCase();
+
+const UNSUPPORTED_HINTS: Record<string, string> = {
+  doc: 'Converta para PDF e envie de novo.',
+  docx: 'Converta para PDF e envie de novo.',
+  xls: 'Salve como .xlsx (ou .csv) e envie de novo.',
+  ppt: 'Converta para PDF e envie de novo.',
+  pptx: 'Converta para PDF e envie de novo.',
+  zip: 'Envie os arquivos separadamente.',
+  rar: 'Envie os arquivos separadamente.',
+  json: 'Converta para .csv ou cole o conteúdo como texto.',
+  xml: 'Converta para .csv ou cole o conteúdo como texto.',
+};
+
+/**
+ * Descobre o formato pelo tipo declarado e, na falta dele, pela extensão do nome do arquivo.
+ * O nome tem prioridade quando o tipo é genérico (`application/octet-stream`), que é o que
+ * navegadores e servidores mandam quando não sabem o que é.
+ */
+export function detectFormat(input: {
+  mimeType?: string | null;
+  fileName?: string | null;
+}): DocumentFormat {
+  const mime = normalizeMimeType(input.mimeType);
+  const extension = extensionOf(input.fileName);
+  const byExtension = BY_EXTENSION[extension];
+  const byMime = BY_MIME[mime];
+
+  if (byMime && (!byExtension || mime !== 'text/plain')) return byMime;
+  if (byExtension) return byExtension;
+  if (byMime) return byMime;
+  // text/* desconhecido (ex.: text/x-log) ainda é texto.
+  if (mime.startsWith('text/')) return 'text';
+
+  const hint = UNSUPPORTED_HINTS[extension];
+  throw knowledgeError(
+    'formato_nao_suportado',
+    `Não sei ler este tipo de arquivo${extension ? ` (.${extension})` : mime ? ` (${mime})` : ''}. ` +
+      `Aceitamos ${SUPPORTED_UPLOAD_EXTENSIONS.join(', ')}.${hint ? ` ${hint}` : ''}`,
+  );
+}
+
+/** `true` se `detectFormat` reconheceria a entrada. */
+export function isSupportedDocument(input: {
+  mimeType?: string | null;
+  fileName?: string | null;
+}): boolean {
+  try {
+    detectFormat(input);
+    return true;
+  } catch (error) {
+    if (error instanceof KnowledgeError) return false;
+    throw error;
+  }
+}
+
+export function assertWithinSize(byteSize: number, maxBytes = DEFAULT_MAX_BYTES): void {
+  if (byteSize > maxBytes) {
+    throw knowledgeError(
+      'arquivo_grande',
+      `O arquivo tem ${formatBytes(byteSize)} e o limite é ${formatBytes(maxBytes)}. ` +
+        'Divida o conteúdo em arquivos menores.',
+    );
+  }
+}
+
+export function formatBytes(bytes: number): string {
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
