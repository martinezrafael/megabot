+      );
+    }
+    // Trecho de outro tenant (e inexistente): 404.
+    assert.equal(
+      (
+        await api(`/chunks/${target.id}`, {
+          method: 'PATCH',
+          cookie: cookieB,
+          body: { content: 'x' },
