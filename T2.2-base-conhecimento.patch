+      ).status,
+      404,
+    );
+    assert.equal(
+      (
+        await api(`/chunks/${randomUUID()}`, {
+          method: 'PATCH',
+          cookie: cookieA,
+          body: { content: 'x' },
+        })
+      ).status,
+      404,
+    );
+
+    const removed = await api(`/chunks/${target.id}`, { method: 'DELETE', cookie: cookieA });
+    assert.equal(removed.status, 204);
+    assert.equal(
+      (await api(`/chunks/${target.id}`, { method: 'DELETE', cookie: cookieA })).status,
