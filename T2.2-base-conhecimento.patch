diff --git a/packages/knowledge/tests/chunk.test.ts b/packages/knowledge/tests/chunk.test.ts
new file mode 100644
index 0000000..317dc44
--- /dev/null
+++ b/packages/knowledge/tests/chunk.test.ts
@@ -0,0 +1,149 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { DEFAULT_CHUNK_OPTIONS, chunkText, parseBlocks } from '../src';
+
+const lorem = (words: number, word = 'palavra') =>
+  Array.from({ length: words }, (_, i) => `${word}${i}`).join(' ');
+
+describe('divisão em trechos', () => {
+  it('texto curto vira um único trecho, sem seção', () => {
+    const chunks = chunkText('Entregamos em todo o Brasil.');
+    assert.equal(chunks.length, 1);
+    assert.deepEqual(chunks[0], {
+      position: 0,
+      content: 'Entregamos em todo o Brasil.',
+      heading: null,
+      charCount: 'Entregamos em todo o Brasil.'.length,
+    });
+  });
+
+  it('cada trecho leva o título da sua seção e seções não se misturam', () => {
+    const chunks = chunkText(
+      [
+        '# Loja Exemplo',
+        '',
+        'Somos uma loja de roupas.',
+        '',
+        '## Entrega',
+        '',
+        'Capitais em 2 dias.',
+        '',
+        '## Trocas',
+        '',
+        'Em até 30 dias.',
+      ].join('\n'),
+    );
+    assert.deepEqual(
+      chunks.map((c) => c.heading),
+      ['Loja Exemplo', 'Entrega', 'Trocas'],
+    );
+    assert.equal(chunks[1]?.content, 'Entrega\n\nCapitais em 2 dias.');
+    assert.ok(!chunks[1]?.content.includes('loja de roupas'));
+  });
+
+  it('nenhum trecho passa do limite, mesmo com parágrafo gigante sem pontuação', () => {
+    const text = [
+      '## Seção A',
+      '',
+      lorem(400),
+      '',
+      lorem(50),
+      '',
+      '## Seção B',
+      '',
+      'x'.repeat(5000),
+    ].join('\n');
+    const chunks = chunkText(text, { maxChars: 500, overlapChars: 50 });
+    assert.ok(chunks.length > 5);
+    for (const chunk of chunks) {
+      assert.ok(chunk.content.length <= 500, `trecho com ${chunk.content.length} caracteres`);
+      assert.ok(chunk.content.trim().length > 0);
+    }
+    assert.deepEqual(
+      chunks.map((c) => c.position),
+      chunks.map((_, i) => i),
+    );
+  });
+
+  it('trechos vizinhos se sobrepõem um pouco (contexto não se perde no corte)', () => {
+    const paragraphs = Array.from({ length: 12 }, (_, i) => `Parágrafo ${i} com algum texto aqui.`);
+    const chunks = chunkText(paragraphs.join('\n\n'), { maxChars: 200, overlapChars: 60 });
+    assert.ok(chunks.length >= 3);
+    const tail = chunks[0]!.content.slice(-40);
+    assert.ok(
+      chunks[1]!.content.includes(tail.split(' ').slice(-3).join(' ')),
+      'o começo do segundo trecho deveria repetir o fim do primeiro',
+    );
+  });
+
+  it('sem sobreposição quando overlapChars é 0', () => {
+    const chunks = chunkText(
+      Array.from({ length: 6 }, (_, i) => `Bloco ${i} ${lorem(20)}`).join('\n\n'),
+      { maxChars: 300, overlapChars: 0 },
+    );
+    assert.ok(chunks.length > 1);
+    assert.ok(!chunks[1]!.content.startsWith('Bloco 0'));
+  });
+
+  it('junta um último trecho curto no anterior (quando couber e for da mesma seção)', () => {
+    const chunks = chunkText(['## S', '', lorem(30), '', 'Fim.'].join('\n'), {
+      maxChars: 1200,
+      minChars: 200,
+    });
+    assert.equal(chunks.length, 1);
+    assert.match(chunks[0]!.content, /Fim\.$/);
+  });
+
+  it('é determinístico: o mesmo texto gera exatamente os mesmos trechos', () => {
+    const text = ['# T', '', lorem(300), '', '## S2', '', lorem(300)].join('\n');
+    assert.deepEqual(chunkText(text), chunkText(text));
+  });
+
+  it('listas e tabelas (linhas seguidas) ficam no mesmo trecho', () => {
+    const chunks = chunkText(
+      ['## Entrega', '', '- Capitais: 2 dias', '- Interior: 5 dias', '- Exterior: 20 dias'].join(
+        '\n',
+      ),
+    );
+    assert.equal(chunks.length, 1);
+    assert.equal(
+      chunks[0]?.content,
+      'Entrega\n\n- Capitais: 2 dias\n- Interior: 5 dias\n- Exterior: 20 dias',
+    );
+  });
+
+  it('texto vazio ou só espaços não gera trecho', () => {
+    assert.deepEqual(chunkText(''), []);
+    assert.deepEqual(chunkText('   \n\n  \t '), []);
+    assert.deepEqual(chunkText('## Só um título'), []);
+  });
+
+  it('opções fora de faixa são ajustadas em vez de quebrar', () => {
+    const chunks = chunkText(lorem(200), { maxChars: 10, overlapChars: 9999 });
+    assert.ok(chunks.every((c) => c.content.length <= 100));
+    assert.ok(chunks.length > 1);
+  });
+
+  it('parseBlocks separa parágrafos e guarda a seção de cada um', () => {
+    const blocks = parseBlocks(
+      ['# A', '', 'um', 'continuação', '', 'dois', '', '## B', '', 'três'].join('\n'),
+    );
+    assert.deepEqual(blocks, [
+      { heading: 'A', text: 'um\ncontinuação' },
+      { heading: 'A', text: 'dois' },
+      { heading: 'B', text: 'três' },
+    ]);
+  });
+
+  it('o padrão (1200/150) divide um documento real em trechos de tamanho razoável', () => {
+    const doc = Array.from(
+      { length: 20 },
+      (_, i) => `## Seção ${i}\n\n${lorem(120)}\n\n${lorem(80)}`,
+    ).join('\n\n');
+    const chunks = chunkText(doc);
+    assert.ok(chunks.length >= 20);
+    const average = chunks.reduce((sum, c) => sum + c.charCount, 0) / chunks.length;
+    assert.ok(average > 400, `média baixa: ${average}`);
+    assert.ok(chunks.every((c) => c.charCount <= DEFAULT_CHUNK_OPTIONS.maxChars));
+  });
+});
diff --git a/packages/knowledge/tests/extract.test.ts b/packages/knowledge/tests/extract.test.ts
new file mode 100644
index 0000000..4bef02e
--- /dev/null
+++ b/packages/knowledge/tests/extract.test.ts
@@ -0,0 +1,129 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, it } from 'node:test';
+import { KnowledgeError, decodeText, extractDocument, pdfToText } from '../src';
+
+const fixture = (name: string) => new Uint8Array(readFileSync(join(__dirname, 'fixtures', name)));
+const bytes = (text: string) => new TextEncoder().encode(text);
+
+describe('PDF -> texto', () => {
+  it('lê o texto com acentos, uma seção por página', async () => {
+    const { text, pageCount } = await pdfToText(fixture('politica.pdf'));
+    assert.equal(pageCount, 2);
+    assert.match(text, /^## Página 1\n/);
+    assert.match(text, /Política de trocas e devoluções/);
+    assert.match(text, /até 30 dias após a compra/);
+    assert.match(text, /## Página 2\n\nAtendimento de segunda a sexta/);
+  });
+
+  it('PDF corrompido vira erro legível', async () => {
+    await assert.rejects(
+      pdfToText(bytes('%PDF-1.4 isto não é um PDF de verdade')),
+      (error: unknown) => {
+        assert.ok(error instanceof KnowledgeError);
+        assert.equal(error.code, 'pdf_invalido');
+        assert.equal(error.retryable, false);
+        assert.match(error.message, /corrompido ou protegido/);
+        return true;
+      },
+    );
+  });
+});
+
+describe('extractDocument', () => {
+  it('PDF escaneado (sem texto) explica que falta OCR', async () => {
+    await assert.rejects(
+      extractDocument({ bytes: fixture('escaneado.pdf'), format: 'pdf' }),
+      (error: unknown) => {
+        assert.ok(error instanceof KnowledgeError);
+        assert.equal(error.code, 'sem_texto');
+        assert.match(error.message, /escaneado/);
+        return true;
+      },
+    );
+  });
+
+  it('arquivo vazio e documento sem texto', async () => {
+    await assert.rejects(extractDocument({ bytes: new Uint8Array(), format: 'text' }), {
+      code: 'documento_vazio',
+    });
+    await assert.rejects(extractDocument({ bytes: bytes('   \n\n  '), format: 'text' }), {
+      code: 'sem_texto',
+    });
+    await assert.rejects(
+      extractDocument({
+        bytes: bytes('<html><body><nav>menu</nav></body></html>'),
+        format: 'html',
+      }),
+      { code: 'sem_texto' },
+    );
+  });
+
+  it('texto e markdown passam direto (sem espaços no fim das linhas)', async () => {
+    const result = await extractDocument({
+      bytes: bytes('  Primeira linha   \r\nSegunda linha\t\n\n'),
+      format: 'text',
+    });
+    // Espaços no fim de cada linha e nas pontas do documento saem; o resto fica como está.
+    assert.equal(result.text, 'Primeira linha\nSegunda linha');
+    assert.equal(result.format, 'text');
+    assert.equal(result.title, null);
+    assert.deepEqual(result.warnings, []);
+  });
+
+  it('planilha: devolve abas e avisos; PDF: devolve número de páginas; HTML: devolve título', async () => {
+    const sheet = await extractDocument({ bytes: fixture('catalogo.xlsx'), format: 'xlsx' });
+    assert.deepEqual(sheet.sheetNames, ['Produtos', 'FAQ']);
+    assert.match(sheet.text, /## Aba: Produtos/);
+
+    const pdf = await extractDocument({ bytes: fixture('politica.pdf'), format: 'pdf' });
+    assert.equal(pdf.pageCount, 2);
+
+    const html = await extractDocument({
+      bytes: bytes('<html><head><title>Minha Loja</title></head><body><p>Olá</p></body></html>'),
+      format: 'html',
+    });
+    assert.equal(html.title, 'Minha Loja');
+    assert.equal(html.text, 'Olá');
+  });
+
+  it('CSV usa o nome do arquivo como rótulo dos avisos', async () => {
+    const result = await extractDocument({
+      bytes: bytes('SKU,Nome\nA1,Caneca\n'),
+      format: 'csv',
+      fileName: 'produtos.csv',
+    });
+    assert.equal(result.text, 'SKU: A1 | Nome: Caneca');
+  });
+});
+
+describe('decodeText', () => {
+  it('UTF-8, com e sem BOM', () => {
+    assert.equal(decodeText(bytes('ação e coração')), 'ação e coração');
+    assert.equal(decodeText(bytes('﻿com BOM')), 'com BOM');
+  });
+
+  it('cai para windows-1252 quando os bytes não são UTF-8 válido (páginas antigas)', () => {
+    // "ação" em windows-1252/latin-1.
+    const latin = Uint8Array.from([0x61, 0xe7, 0xe3, 0x6f]);
+    assert.equal(decodeText(latin), 'ação');
+    assert.equal(decodeText(latin, 'iso-8859-1'), 'ação');
+  });
+
+  it('charset declarado tem prioridade, e um charset inventado não quebra', () => {
+    assert.equal(decodeText(bytes('ok'), 'charset-que-nao-existe'), 'ok');
+    assert.equal(decodeText(bytes('acentuação'), 'utf-8'), 'acentuação');
+  });
+
+  it('HTML com <meta charset=iso-8859-1> é lido certo pelo extractDocument', async () => {
+    const head = Buffer.from('<html><head><meta charset="iso-8859-1"></head><body><p>', 'latin1');
+    const body = Buffer.from('Promoção de inverno', 'latin1');
+    const tail = Buffer.from('</p></body></html>', 'latin1');
+    const result = await extractDocument({
+      bytes: new Uint8Array(Buffer.concat([head, body, tail])),
+      format: 'html',
+    });
+    assert.equal(result.text, 'Promoção de inverno');
+  });
+});
diff --git a/packages/knowledge/tests/fetch-url.test.ts b/packages/knowledge/tests/fetch-url.test.ts
new file mode 100644
index 0000000..d162653
--- /dev/null
+++ b/packages/knowledge/tests/fetch-url.test.ts
@@ -0,0 +1,307 @@
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { after, before, describe, it } from 'node:test';
+import {
+  KnowledgeError,
+  assertHttpUrl,
+  assertPublicHost,
+  fetchRemoteDocument,
+  isPrivateAddress,
+  type LookupFn,
+} from '../src';
+
+/** O servidor de teste roda em 127.0.0.1; este lookup finge que o domínio é público. */
+const publicLookup: LookupFn = async () => [{ address: '93.184.216.34', family: 4 }];
+
+describe('URL: validação e proteção contra SSRF', () => {
+  it('aceita http/https e recusa o resto', () => {
+    assert.equal(assertHttpUrl(' https://exemplo.com.br/sobre ').hostname, 'exemplo.com.br');
+    for (const bad of [
+      '',
+      'exemplo.com.br',
+      'file:///etc/passwd',
+      'ftp://a.com',
+      'javascript:alert(1)',
+    ]) {
+      assert.throws(() => assertHttpUrl(bad), { code: 'url_invalida' });
+    }
+  });
+
+  it('recusa endereço com usuário e senha embutidos', () => {
+    assert.throws(() => assertHttpUrl('https://user:senha@exemplo.com'), {
+      code: 'url_invalida',
+    });
+  });
+
+  it('reconhece endereços de rede interna', () => {
+    const privados = [
+      '127.0.0.1',
+      '10.0.0.5',
+      '172.16.0.1',
+      '172.31.255.255',
+      '192.168.1.1',
+      '169.254.169.254', // metadados de nuvem: o alvo clássico de SSRF
+      '0.0.0.0',
+      '100.64.0.1',
+      '224.0.0.1',
+      '::1',
+      '::',
+      'fc00::1',
+      'fe80::1',
+      '::ffff:10.0.0.1',
+      '999.1.1.1',
+      'nao-e-ip',
+    ];
+    for (const address of privados) {
+      assert.equal(isPrivateAddress(address), true, `${address} deveria ser privado`);
+    }
+    for (const address of [
+      '8.8.8.8',
+      '93.184.216.34',
+      '172.32.0.1',
+      '192.167.1.1',
+      '2606:4700::1',
+    ]) {
+      assert.equal(isPrivateAddress(address), false, `${address} deveria ser público`);
+    }
+  });
+
+  it('bloqueia nomes internos e IPs privados antes de qualquer requisição', async () => {
+    for (const host of ['http://localhost:3000/x', 'http://api.local/x', 'http://db.internal/x']) {
+      await assert.rejects(assertPublicHost(assertHttpUrl(host), publicLookup), {
+        code: 'url_bloqueada',
+      });
+    }
+    await assert.rejects(
+      assertPublicHost(assertHttpUrl('http://169.254.169.254/latest/meta-data')),
+      {
+        code: 'url_bloqueada',
+      },
+    );
+    // Domínio público que RESOLVE para IP interno também é bloqueado.
+    await assert.rejects(
+      assertPublicHost(assertHttpUrl('https://interno.exemplo.com'), async () => [
+        { address: '10.1.2.3', family: 4 },
+      ]),
+      { code: 'url_bloqueada' },
+    );
+    // DNS que não resolve: erro de acesso (vale tentar de novo).
+    await assert.rejects(
+      assertPublicHost(assertHttpUrl('https://nao-existe.exemplo'), async () => {
+        throw new Error('ENOTFOUND');
+      }),
+      (error: unknown) => {
+        assert.ok(error instanceof KnowledgeError);
+        assert.equal(error.code, 'url_inacessivel');
+        assert.equal(error.retryable, true);
+        return true;
+      },
+    );
+    await assert.doesNotReject(
+      assertPublicHost(assertHttpUrl('https://exemplo.com'), publicLookup),
+    );
+  });
+});
+
+describe('download da URL (servidor HTTP local)', () => {
+  let server: http.Server;
+  let base = '';
+  const requests: string[] = [];
+
+  before(async () => {
+    server = http.createServer((req, res) => {
+      requests.push(req.url ?? '');
+      const url = req.url ?? '/';
+      if (url === '/pagina') {
+        res.setHeader('content-type', 'text/html; charset=utf-8');
+        return void res.end(
+          '<html><head><title>Loja</title></head><body><h1>Sobre</h1><p>Texto da página.</p></body></html>',
+        );
+      }
+      if (url === '/latin') {
+        res.setHeader('content-type', 'text/html; charset=iso-8859-1');
+        return void res.end(Buffer.from('<html><body><p>Promoção</p></body></html>', 'latin1'));
+      }
+      if (url === '/catalogo.csv') {
+        res.setHeader('content-type', 'text/plain');
+        return void res.end('SKU,Nome\nA1,Caneca\n');
+      }
+      if (url === '/redireciona') {
+        res.statusCode = 302;
+        res.setHeader('location', '/pagina');
+        return void res.end();
+      }
+      if (url === '/redireciona-interno') {
+        res.statusCode = 302;
+        res.setHeader('location', 'http://169.254.169.254/latest/meta-data');
+        return void res.end();
+      }
+      if (url === '/loop') {
+        res.statusCode = 302;
+        res.setHeader('location', '/loop');
+        return void res.end();
+      }
+      if (url === '/grande') {
+        // Em pedaços, sem content-length: é o caso em que só o download revela o tamanho.
+        res.setHeader('content-type', 'text/plain');
+        for (let i = 0; i < 50; i += 1) res.write('x'.repeat(1000));
+        return void res.end();
+      }
+      if (url === '/grande-declarado') {
+        res.setHeader('content-type', 'text/plain');
+        res.setHeader('content-length', '999999999');
+        return void res.end('x');
+      }
+      if (url === '/imagem') {
+        res.setHeader('content-type', 'image/png');
+        return void res.end(Buffer.from([0x89, 0x50]));
+      }
+      if (url === '/vazia') {
+        res.setHeader('content-type', 'text/html');
+        return void res.end('');
+      }
+      if (url === '/lenta') return; // nunca responde
+      if (url === '/404') {
+        res.statusCode = 404;
+        return void res.end('nao achei');
+      }
+      if (url === '/500') {
+        res.statusCode = 503;
+        return void res.end('instavel');
+      }
+      res.statusCode = 404;
+      res.end();
+    });
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+    base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+  });
+
+  after(async () => {
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+
+  /**
+   * O código só aceita hosts públicos, e o servidor de teste é 127.0.0.1. Então a URL usa um
+   * domínio de teste ("exemplo.test", que o lookup finge resolver para um IP público) e este
+   * fetch troca a origem pela do servidor local no último instante. Assim as proteções são
+   * exercitadas de verdade, sem exceção nenhuma no código de produção.
+   */
+  const ORIGIN = 'https://exemplo.test';
+  const rewritingFetch =
+    (target: () => string): typeof fetch =>
+    (input, init) =>
+      fetch(String(input).replace(ORIGIN, target()), init);
+
+  const get = (path: string, options = {}) =>
+    fetchRemoteDocument(`${ORIGIN}${path}`, {
+      lookup: publicLookup,
+      fetch: rewritingFetch(() => base),
+      ...options,
+    });
+
+  it('baixa uma página HTML com tipo, charset e URL final', async () => {
+    const doc = await get('/pagina');
+    assert.equal(doc.mimeType, 'text/html');
+    assert.equal(doc.charset, 'utf-8');
+    assert.equal(doc.format, 'html');
+    assert.equal(doc.finalUrl, `${ORIGIN}/pagina`);
+    assert.match(Buffer.from(doc.bytes).toString('utf8'), /Texto da página/);
+  });
+
+  it('descobre o formato pelo nome quando o tipo é genérico', async () => {
+    const doc = await get('/catalogo.csv');
+    assert.equal(doc.format, 'csv');
+    assert.equal(doc.fileName, 'catalogo.csv');
+  });
+
+  it('informa o charset declarado (para decodificar latin-1 depois)', async () => {
+    const doc = await get('/latin');
+    assert.equal(doc.charset, 'iso-8859-1');
+  });
+
+  it('segue redirecionamento, revalidando o destino', async () => {
+    const doc = await get('/redireciona');
+    assert.equal(doc.finalUrl, `${ORIGIN}/pagina`);
+
+    await assert.rejects(get('/redireciona-interno'), { code: 'url_bloqueada' });
+    await assert.rejects(get('/loop'), (error: unknown) => {
+      assert.ok(error instanceof KnowledgeError);
+      assert.equal(error.code, 'url_inacessivel');
+      assert.match(error.message, /redirecionamentos demais/);
+      return true;
+    });
+  });
+
+  it('respeita o limite de tamanho (declarado e real)', async () => {
+    await assert.rejects(get('/grande-declarado', { maxBytes: 1000 }), {
+      code: 'arquivo_grande',
+    });
+    await assert.rejects(get('/grande', { maxBytes: 1000 }), (error: unknown) => {
+      assert.ok(error instanceof KnowledgeError);
+      assert.equal(error.code, 'arquivo_grande');
+      assert.match(error.message, /interrompido/);
+      return true;
+    });
+    assert.ok((await get('/grande', { maxBytes: 100_000 })).bytes.byteLength === 50_000);
+  });
+
+  it('erro do site: 404 não repete, 503 repete', async () => {
+    await assert.rejects(get('/404'), (error: unknown) => {
+      assert.ok(error instanceof KnowledgeError);
+      assert.equal(error.code, 'url_erro_http');
+      assert.equal(error.retryable, false);
+      assert.match(error.message, /sem login/);
+      return true;
+    });
+    await assert.rejects(get('/500'), (error: unknown) => {
+      assert.ok(error instanceof KnowledgeError);
+      assert.equal(error.retryable, true);
+      return true;
+    });
+  });
+
+  it('tipo não suportado e página vazia', async () => {
+    await assert.rejects(get('/imagem'), { code: 'formato_nao_suportado' });
+    await assert.rejects(get('/vazia'), { code: 'documento_vazio' });
+  });
+
+  it('site que não responde vira erro de acesso (repetível), sem travar', async () => {
+    await assert.rejects(get('/lenta', { timeoutMs: 150 }), (error: unknown) => {
+      assert.ok(error instanceof KnowledgeError);
+      assert.equal(error.code, 'url_inacessivel');
+      assert.equal(error.retryable, true);
+      assert.match(error.message, /não respondeu/);
+      return true;
+    });
+  });
+
+  it('servidor fora do ar vira erro de acesso repetível', async () => {
+    await assert.rejects(
+      fetchRemoteDocument(`${ORIGIN}/x`, {
+        lookup: publicLookup,
+        fetch: rewritingFetch(() => 'http://127.0.0.1:1'),
+      }),
+      (error: unknown) => {
+        assert.ok(error instanceof KnowledgeError);
+        assert.equal(error.code, 'url_inacessivel');
+        assert.equal(error.retryable, true);
+        return true;
+      },
+    );
+  });
+
+  it('manda um user agent honesto (sites que bloqueiam anônimos)', async () => {
+    const seen: Array<Record<string, string>> = [];
+    await fetchRemoteDocument(`${ORIGIN}/pagina`, {
+      lookup: publicLookup,
+      fetch: async (input, init) => {
+        seen.push({ ...(init?.headers as Record<string, string>) });
+        return rewritingFetch(() => base)(input, init);
+      },
+    });
+    assert.match(seen[0]!['user-agent']!, /MegabotKnowledgeBot/);
+    assert.match(seen[0]!['accept-language']!, /pt-BR/);
+  });
+});
