+    await replaceKnowledgeChunks(
+      tenantA,
+      source.id,
+      Array.from({ length: 5 }, (_, i) => ({
+        position: i,
+        content: `Trecho número ${i}`,
+        heading: i === 0 ? 'Introdução' : null,
+        embedding: vector(i),
+      })),
+      'modelo-teste',
+    );
+
+    const page = await json<{ total: number; items: Array<Record<string, unknown>> }>(
