diff --git a/apps/web/src/components/knowledge-add-forms.tsx b/apps/web/src/components/knowledge-add-forms.tsx
new file mode 100644
index 0000000..aba9243
--- /dev/null
+++ b/apps/web/src/components/knowledge-add-forms.tsx
@@ -0,0 +1,177 @@
+'use client';
+
+import { useRouter } from 'next/navigation';
+import { useRef, useState, type FormEvent } from 'react';
+import { apiRequest } from '@/lib/api-browser';
+import type { KnowledgeLimits } from '@/lib/knowledge';
+import { formatBytes } from '@/lib/knowledge-format';
+
+type Tab = 'arquivo' | 'site' | 'texto';
+
+/**
+ * As três formas de alimentar a base: enviar arquivo, importar um site e colar texto.
+ * Depois de criar a fonte, `router.refresh()` recarrega a lista (que já mostra "Na fila").
+ */
+export function KnowledgeAddForms({ limits }: { limits: KnowledgeLimits }) {
+  const router = useRouter();
+  const [tab, setTab] = useState<Tab>('arquivo');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const fileInput = useRef<HTMLInputElement>(null);
+
+  function start() {
+    setBusy(true);
+    setError(null);
+    setSuccess(null);
+  }
+
+  function finish(result: { ok: boolean; error?: string }, message: string) {
+    setBusy(false);
+    if (!result.ok) return setError(result.error ?? 'Não foi possível adicionar.');
+    setSuccess(message);
+    router.refresh();
+  }
+
+  async function sendFile(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const file = fileInput.current?.files?.[0];
+    if (!file) return setError('Escolha um arquivo.');
+    if (file.size > limits.maxUploadBytes) {
+      return setError(
+        `O arquivo tem ${formatBytes(file.size)} e o limite é ${formatBytes(limits.maxUploadBytes)}.`,
+      );
+    }
+    start();
+    // O corpo é o próprio arquivo (sem multipart): o nome vai na query.
+    const result = await apiRequest(
+      `/knowledge/sources/upload?fileName=${encodeURIComponent(file.name)}`,
+      {
+        method: 'POST',
+        body: file,
+        headers: { 'Content-Type': file.type || 'application/octet-stream' },
+      },
+    );
+    if (result.ok && fileInput.current) fileInput.current.value = '';
+    finish(result, `"${file.name}" enviado. Estamos processando.`);
+  }
+
+  async function sendUrl(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    // O elemento tem de ser guardado ANTES do await: depois do handler, currentTarget fica nulo.
+    const formEl = event.currentTarget;
+    const form = new FormData(formEl);
+    start();
+    const result = await apiRequest('/knowledge/sources', {
+      method: 'POST',
+      json: { kind: 'url', url: String(form.get('url') ?? '').trim() },
+    });
+    if (result.ok) formEl.reset();
+    finish(result, 'Site adicionado. Estamos lendo a página.');
+  }
+
+  async function sendText(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const formEl = event.currentTarget;
+    const form = new FormData(formEl);
+    const title = String(form.get('title') ?? '').trim();
+    start();
+    const result = await apiRequest('/knowledge/sources', {
+      method: 'POST',
+      json: {
+        kind: 'text',
+        text: String(form.get('text') ?? ''),
+        ...(title ? { title } : {}),
+      },
+    });
+    if (result.ok) formEl.reset();
+    finish(result, 'Texto adicionado. Estamos processando.');
+  }
+
+  return (
+    <section className="card">
+      <div className="tabs" role="tablist" aria-label="Como adicionar conteúdo">
+        {(
+          [
+            ['arquivo', 'Enviar arquivo'],
+            ['site', 'Importar site'],
+            ['texto', 'Colar texto'],
+          ] as const
+        ).map(([value, label]) => (
+          <button
+            key={value}
+            type="button"
+            role="tab"
+            aria-selected={tab === value}
+            onClick={() => setTab(value)}
+          >
+            {label}
+          </button>
+        ))}
+      </div>
+
+      {tab === 'arquivo' ? (
+        <form onSubmit={sendFile}>
+          <label htmlFor="kb-file">Arquivo</label>
+          <input
+            id="kb-file"
+            ref={fileInput}
+            type="file"
+            accept={limits.acceptedExtensions.join(',')}
+            required
+          />
+          <p className="muted">
+            Aceitamos {limits.acceptedExtensions.join(', ')} — até{' '}
+            {formatBytes(limits.maxUploadBytes)}. PDF escaneado (foto) não funciona: precisa ter
+            texto selecionável.
+          </p>
+          <button type="submit" className="primary" disabled={busy}>
+            {busy ? 'Enviando…' : 'Enviar arquivo'}
+          </button>
+        </form>
+      ) : null}
+
+      {tab === 'site' ? (
+        <form onSubmit={sendUrl}>
+          <label htmlFor="kb-url">Endereço da página</label>
+          <input
+            id="kb-url"
+            name="url"
+            type="url"
+            placeholder="https://suaempresa.com.br/perguntas-frequentes"
+            required
+          />
+          <p className="muted">
+            Lemos uma página por vez (a página precisa estar pública, sem login).
+          </p>
+          <button type="submit" className="primary" disabled={busy}>
+            {busy ? 'Importando…' : 'Importar página'}
+          </button>
+        </form>
+      ) : null}
+
+      {tab === 'texto' ? (
+        <form onSubmit={sendText}>
+          <label htmlFor="kb-title">Nome (opcional)</label>
+          <input id="kb-title" name="title" type="text" placeholder="Perguntas frequentes" />
+          <label htmlFor="kb-text">Conteúdo</label>
+          <textarea
+            id="kb-text"
+            name="text"
+            rows={8}
+            required
+            placeholder={
+              'Horário de atendimento: segunda a sexta, 9h às 18h.\nFrete grátis acima de R$ 199.'
+            }
+          />
+          <button type="submit" className="primary" disabled={busy}>
+            {busy ? 'Salvando…' : 'Adicionar texto'}
+          </button>
+        </form>
+      ) : null}
+
+      {error ? <p className="error">{error}</p> : null}
+      {success ? <p className="success">{success}</p> : null}
+    </section>
+  );
+}
diff --git a/apps/web/src/components/knowledge-chunk-list.tsx b/apps/web/src/components/knowledge-chunk-list.tsx
new file mode 100644
index 0000000..71d68bc
--- /dev/null
+++ b/apps/web/src/components/knowledge-chunk-list.tsx
@@ -0,0 +1,126 @@
+'use client';
+
+import { useRouter } from 'next/navigation';
+import { useState } from 'react';
+import { apiRequest } from '@/lib/api-browser';
+import type { KnowledgeChunk } from '@/lib/knowledge';
+import { formatNumber } from '@/lib/knowledge-format';
+
+/**
+ * Trechos da fonte, com edição no lugar. Editar vale na hora; o embedding é recalculado pelo
+ * worker em seguida (enquanto isso o trecho aparece como "embedding sendo recalculado").
+ */
+export function KnowledgeChunkList({ chunks, total }: { chunks: KnowledgeChunk[]; total: number }) {
+  if (chunks.length === 0) {
+    return (
+      <p className="muted">
+        Nenhum trecho ainda. Eles aparecem quando a fonte termina de ser processada.
+      </p>
+    );
+  }
+  return (
+    <>
+      <p className="muted">
+        {formatNumber(total)} trecho{total === 1 ? '' : 's'}. É isto que o assistente pesquisa para
+        responder.
+      </p>
+      <ol className="chunk-list">
+        {chunks.map((chunk) => (
+          <li key={chunk.id}>
+            <ChunkItem chunk={chunk} />
+          </li>
+        ))}
+      </ol>
+    </>
+  );
+}
+
+/** O texto do trecho já começa com o título da seção (ele vai junto para o embedding). */
+const repeatsHeading = (chunk: KnowledgeChunk) =>
+  Boolean(chunk.heading) && chunk.content.trimStart().startsWith(chunk.heading!);
+
+function ChunkItem({ chunk }: { chunk: KnowledgeChunk }) {
+  const router = useRouter();
+  const [editing, setEditing] = useState(false);
+  const [content, setContent] = useState(chunk.content);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function save() {
+    setBusy(true);
+    setError(null);
+    const result = await apiRequest(`/knowledge/chunks/${chunk.id}`, {
+      method: 'PATCH',
+      json: { content },
+    });
+    setBusy(false);
+    if (!result.ok) return setError(result.error ?? 'Não foi possível salvar.');
+    setEditing(false);
+    router.refresh();
+  }
+
+  async function remove() {
+    if (!window.confirm('Apagar este trecho?')) return;
+    setBusy(true);
+    setError(null);
+    const result = await apiRequest(`/knowledge/chunks/${chunk.id}`, { method: 'DELETE' });
+    setBusy(false);
+    if (!result.ok) return setError(result.error ?? 'Não foi possível apagar.');
+    router.refresh();
+  }
+
+  return (
+    <article className="chunk">
+      <header>
+        <span className="badge">#{chunk.position + 1}</span>
+        {chunk.heading && !repeatsHeading(chunk) ? (
+          <span className="chunk-heading">{chunk.heading}</span>
+        ) : null}
+        {chunk.edited ? <span className="badge">editado</span> : null}
+        {chunk.embeddingStale ? <span className="badge">recalculando busca</span> : null}
+        {!chunk.hasEmbedding ? <span className="badge">sem embedding</span> : null}
+      </header>
+
+      {editing ? (
+        <>
+          <textarea
+            value={content}
+            rows={Math.min(14, Math.max(4, Math.ceil(content.length / 80)))}
+            onChange={(event) => setContent(event.target.value)}
+            aria-label={`Conteúdo do trecho ${chunk.position + 1}`}
+          />
+          <div className="actions">
+            <button type="button" className="primary" onClick={save} disabled={busy}>
+              {busy ? 'Salvando…' : 'Salvar'}
+            </button>
+            <button
+              type="button"
+              onClick={() => {
+                setContent(chunk.content);
+                setEditing(false);
+                setError(null);
+              }}
+              disabled={busy}
+            >
+              Cancelar
+            </button>
+          </div>
+        </>
+      ) : (
+        <>
+          <p className="chunk-content">{chunk.content}</p>
+          <div className="actions">
+            <button type="button" onClick={() => setEditing(true)}>
+              Editar
+            </button>
+            <button type="button" onClick={remove} disabled={busy}>
+              Apagar
+            </button>
+            <span className="muted">{formatNumber(chunk.charCount)} caracteres</span>
+          </div>
+        </>
+      )}
+      {error ? <p className="error">{error}</p> : null}
+    </article>
+  );
+}
