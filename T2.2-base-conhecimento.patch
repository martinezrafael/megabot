@@ -0,0 +1,69 @@
+import { cookies, headers } from 'next/headers';
+import { redirect } from 'next/navigation';
+import { AutoRefresh } from '@/components/auto-refresh';
+import { KnowledgeAddForms } from '@/components/knowledge-add-forms';
+import { KnowledgeSourcesTable } from '@/components/knowledge-sources-table';
+import { parseWebEnv } from '@/env';
+import {
+  fetchKnowledgeLimits,
+  fetchKnowledgeSources,
+  type KnowledgeFetchOptions,
+} from '@/lib/knowledge';
+import { hasWorkInProgress } from '@/lib/knowledge-format';
+import { getMe } from '@/lib/server-session';
+
+export const dynamic = 'force-dynamic';
+export const metadata = { title: 'Base de conhecimento · Megabot' };
+
+/** Opções de requisição à API, repassando o cookie de sessão de quem está vendo a tela. */
+export async function knowledgeOptions(): Promise<KnowledgeFetchOptions> {
+  const [cookieStore, requestHeaders] = await Promise.all([cookies(), headers()]);
+  return {
+    apiUrl: parseWebEnv(process.env).serverApiUrl,
+    cookie: cookieStore.toString(),
+    forwardedFor: requestHeaders.get('x-forwarded-for') ?? undefined,
+    requestId: requestHeaders.get('x-request-id') ?? undefined,
+  };
+}
+
+/**
+ * Base de conhecimento: o que a empresa ensina ao assistente.
+ * Mostra as fontes com situação e progresso e, enquanto algo está sendo processado, atualiza sozinha.
+ */
+export default async function KnowledgePage() {
+  const me = await getMe();
+  if (!me) redirect('/sign-in');
+
+  const options = await knowledgeOptions();
+  const [sources, limits] = await Promise.all([
+    fetchKnowledgeSources(options),
+    fetchKnowledgeLimits(options),
+  ]);
+
+  if (sources.status !== 'ok' || limits.status !== 'ok') {
+    return (
+      <section>
+        <h1>Base de conhecimento</h1>
+        <p className="notice">
+          Não foi possível carregar a base agora. Atualize a página em alguns instantes.
+        </p>
+      </section>
+    );
+  }
+
+  return (
+    <section>
+      <h1>Base de conhecimento</h1>
+      <p className="subtitle">
+        O assistente responde com base nestes conteúdos. Envie arquivos, importe páginas do site ou
+        cole textos.
+      </p>
+
+      <KnowledgeAddForms limits={limits.data} />
+
+      <h2>Fontes</h2>
+      {hasWorkInProgress(sources.data) ? <AutoRefresh seconds={10} /> : null}
+      <KnowledgeSourcesTable sources={sources.data} />
+    </section>
+  );
+}
diff --git a/apps/web/src/app/globals.css b/apps/web/src/app/globals.css
index 26693a2..f315677 100644
--- a/apps/web/src/app/globals.css
+++ b/apps/web/src/app/globals.css
@@ -296,3 +296,110 @@ dd {
   cursor: pointer;
   font: inherit;
 }
+
+/* ---------------------------------------------------------------------------
+   Base de conhecimento (T2.2)
+   --------------------------------------------------------------------------- */
+/*
+ * O quadro do app é um item de grid (body é grid): por padrão um item não encolhe abaixo do
+ * conteúdo (min-width: auto). Sem isto, uma tabela larga (a lista de fontes) estica o layout
+ * inteiro no celular e o navegador "afasta o zoom". Com min-width: 0, a tabela rola dentro da
+ * sua caixa e o resto da tela continua na largura do aparelho.
+ */
+.shell {
+  min-width: 0;
+}
+.table-wrap {
+  max-width: 100%;
+}
+
+/*
+ * Mesma história dentro dos formulários: um <input type="file"> tem largura natural grande e, como
+ * item de grid, não encolhe sozinho. Sem isto, o campo de arquivo vaza para fora da tela no celular.
+ */
+.shell-main form,
+.shell-main label {
+  min-width: 0;
+}
+.shell-main input,
+.shell-main textarea {
+  max-width: 100%;
+  min-width: 0;
+}
+
+/* O .card padrão é estreito (telas de login). Dentro do app ele ocupa a largura toda. */
+.shell-main .card {
+  max-width: none;
+  margin-bottom: 24px;
+}
+textarea {
+  padding: 10px 12px;
+  font: inherit;
+  color: inherit;
+  background: transparent;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  resize: vertical;
+}
+textarea:focus {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+.tabs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 18px;
+}
+.tabs button[aria-selected='true'] {
+  background: var(--accent);
+  color: var(--accent-text);
+  border-color: var(--accent);
+}
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px 12px;
+  align-items: center;
+  margin: 12px 0;
+}
+progress {
+  display: block;
+  width: 120px;
+  height: 6px;
+  margin-top: 6px;
+}
+.chunk-list {
+  display: grid;
+  gap: 12px;
+  padding: 0;
+  margin: 12px 0 0;
+  list-style: none;
+}
+.chunk {
+  padding: 14px 16px;
+  background: var(--card);
+  border: 1px solid var(--border);
