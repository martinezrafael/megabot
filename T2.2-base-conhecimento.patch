+    assert.ok(metrics.some((m) => m.outcome === 'rejected'));
+    assert.ok(metrics.every((m) => typeof m.tenant_id === 'string'));
+
+    const all = logs.join('');
+    assert.ok(!all.includes(SEGREDO), 'o texto da fonte apareceu no log');
