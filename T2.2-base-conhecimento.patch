diff --git a/packages/storage/src/local.ts b/packages/storage/src/local.ts
new file mode 100644
index 0000000..91e9744
--- /dev/null
+++ b/packages/storage/src/local.ts
@@ -0,0 +1,76 @@
+import { mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { dirname, join, resolve, sep } from 'node:path';
+import { StorageError, assertValidKey, type ObjectStorage } from './types';
+
+/**
+ * Driver de disco: guarda os arquivos numa pasta do projeto (padrão `.data/uploads`).
+ * Serve para desenvolvimento e testes — não use em produção com mais de uma máquina, porque
+ * cada máquina teria a sua pasta.
+ */
+export class LocalObjectStorage implements ObjectStorage {
+  readonly driver = 'local';
+  /** Pasta raiz (absoluta). Útil em teste e em log; nunca vem do cliente. */
+  readonly root: string;
+
+  constructor(rootDir: string) {
+    this.root = resolve(rootDir);
+  }
+
+  /** Caminho absoluto da chave, conferindo que ele continua DENTRO da pasta raiz. */
+  private pathOf(key: string): string {
+    const path = resolve(join(this.root, assertValidKey(key)));
+    if (path !== this.root && !path.startsWith(this.root + sep)) {
+      throw new StorageError('chave_invalida', `Chave de arquivo inválida: "${key}".`);
+    }
+    return path;
+  }
+
+  async put(key: string, bytes: Uint8Array, options: { contentType?: string } = {}): Promise<void> {
+    // O disco não guarda o tipo do arquivo; ele fica no banco (knowledge_sources.mime_type).
+    void options.contentType;
+    const path = this.pathOf(key);
+    try {
+      await mkdir(dirname(path), { recursive: true });
+      await writeFile(path, bytes);
+    } catch (error) {
+      throw new StorageError('indisponivel', 'Não foi possível gravar o arquivo em disco.', true, {
+        cause: error,
+      });
+    }
+  }
+
+  async get(key: string): Promise<Uint8Array> {
+    const path = this.pathOf(key);
+    try {
+      return new Uint8Array(await readFile(path));
+    } catch (error) {
+      if ((error as { code?: string }).code === 'ENOENT') {
+        throw new StorageError(
+          'nao_encontrado',
+          `Arquivo "${key}" não está mais no storage.`,
+          false,
+          {
+            cause: error,
+          },
+        );
+      }
+      throw new StorageError('indisponivel', 'Não foi possível ler o arquivo do disco.', true, {
+        cause: error,
+      });
+    }
+  }
+
+  async delete(key: string): Promise<void> {
+    await rm(this.pathOf(key), { force: true });
+  }
+
+  async exists(key: string): Promise<boolean> {
+    try {
+      await readFile(this.pathOf(key));
+      return true;
+    } catch (error) {
+      if ((error as { code?: string }).code === 'ENOENT') return false;
+      throw error;
+    }
+  }
+}
diff --git a/packages/storage/src/s3.ts b/packages/storage/src/s3.ts
new file mode 100644
index 0000000..86fea13
--- /dev/null
+++ b/packages/storage/src/s3.ts
@@ -0,0 +1,153 @@
+import {
+  DeleteObjectCommand,
+  GetObjectCommand,
+  HeadObjectCommand,
+  PutObjectCommand,
+  S3Client,
+} from '@aws-sdk/client-s3';
+import { StorageError, assertValidKey, type ObjectStorage } from './types';
+
+/**
+ * Driver S3. Serve para a Cloudflare R2 (que fala o protocolo do S3): basta apontar `endpoint`
+ * para `https://<conta>.r2.cloudflarestorage.com` e usar `region: 'auto'`.
+ *
+ * Só o que precisamos: gravar, ler, apagar e checar. Sem URL pré-assinada por enquanto — o
+ * upload passa pela API, que valida tipo e tamanho antes de guardar (ADR 0020).
+ */
+
+/** O mínimo que usamos do cliente da AWS: facilita trocar por um dublê nos testes. */
+export interface S3Like {
+  send(command: unknown): Promise<unknown>;
+}
+
+export interface S3StorageOptions {
+  bucket: string;
+  region?: string;
+  /** Obrigatório na R2 e em compatíveis (MinIO); vazio = AWS S3. */
+  endpoint?: string | undefined;
+  accessKeyId?: string | undefined;
+  secretAccessKey?: string | undefined;
+  /** R2 e MinIO precisam de caminho no lugar de subdomínio. */
+  forcePathStyle?: boolean;
+  /** Nome que aparece nos logs (`r2` ou `s3`). */
+  driver?: string;
+  client?: S3Like;
+}
+
+interface AwsError {
+  name?: string;
+  $metadata?: { httpStatusCode?: number };
+}
+
+export class S3ObjectStorage implements ObjectStorage {
+  readonly driver: string;
+  private readonly bucket: string;
+  private readonly client: S3Like;
+
+  constructor(options: S3StorageOptions) {
+    if (!options.bucket?.trim()) {
+      throw new StorageError('configuracao', 'STORAGE_BUCKET é obrigatório para o driver s3/r2.');
+    }
+    this.bucket = options.bucket;
+    this.driver =
+      options.driver ?? (options.endpoint?.includes('r2.cloudflarestorage.com') ? 'r2' : 's3');
+    this.client =
+      options.client ??
+      new S3Client({
+        region: options.region ?? 'auto',
+        ...(options.endpoint ? { endpoint: options.endpoint } : {}),
+        forcePathStyle: options.forcePathStyle ?? Boolean(options.endpoint),
+        ...(options.accessKeyId && options.secretAccessKey
+          ? {
+              credentials: {
+                accessKeyId: options.accessKeyId,
+                secretAccessKey: options.secretAccessKey,
+              },
+            }
+          : {}),
+      });
+  }
+
+  /** Erro da AWS -> erro nosso (com `retryable` para o job decidir se tenta de novo). */
+  private fail(error: unknown, action: string): never {
+    const aws = error as AwsError;
+    const status = aws.$metadata?.httpStatusCode;
+    if (aws.name === 'NoSuchKey' || aws.name === 'NotFound' || status === 404) {
+      throw new StorageError('nao_encontrado', 'Arquivo não está mais no storage.', false, {
+        cause: error,
+      });
+    }
+    if (status === 401 || status === 403) {
+      throw new StorageError(
+        'configuracao',
+        'O storage recusou o acesso: confira as credenciais e o nome do bucket.',
+        false,
+        { cause: error },
+      );
+    }
+    throw new StorageError('indisponivel', `Falha ao ${action} o arquivo no storage.`, true, {
+      cause: error,
+    });
+  }
+
+  async put(key: string, bytes: Uint8Array, options: { contentType?: string } = {}): Promise<void> {
+    try {
+      await this.client.send(
+        new PutObjectCommand({
+          Bucket: this.bucket,
+          Key: assertValidKey(key),
+          Body: bytes,
+          ContentLength: bytes.byteLength,
+          ...(options.contentType ? { ContentType: options.contentType } : {}),
+        }),
+      );
+    } catch (error) {
+      if (error instanceof StorageError) throw error;
+      this.fail(error, 'gravar');
+    }
+  }
+
+  async get(key: string): Promise<Uint8Array> {
+    try {
+      const response = (await this.client.send(
+        new GetObjectCommand({ Bucket: this.bucket, Key: assertValidKey(key) }),
+      )) as { Body?: { transformToByteArray?: () => Promise<Uint8Array> } };
+      const body = response.Body;
+      if (!body?.transformToByteArray) {
+        throw new StorageError('indisponivel', 'O storage devolveu uma resposta vazia.', true);
+      }
+      return await body.transformToByteArray();
+    } catch (error) {
+      if (error instanceof StorageError) throw error;
+      this.fail(error, 'ler');
+    }
+  }
+
+  async delete(key: string): Promise<void> {
+    try {
+      await this.client.send(
+        new DeleteObjectCommand({ Bucket: this.bucket, Key: assertValidKey(key) }),
+      );
+    } catch (error) {
+      if (error instanceof StorageError) throw error;
+      // Apagar é idempotente: "não existe" é sucesso.
+      const aws = error as AwsError;
+      if (aws.name === 'NoSuchKey' || aws.$metadata?.httpStatusCode === 404) return;
+      this.fail(error, 'apagar');
+    }
+  }
+
+  async exists(key: string): Promise<boolean> {
+    try {
+      await this.client.send(
+        new HeadObjectCommand({ Bucket: this.bucket, Key: assertValidKey(key) }),
+      );
+      return true;
+    } catch (error) {
+      if (error instanceof StorageError) throw error;
+      const aws = error as AwsError;
+      if (aws.name === 'NotFound' || aws.$metadata?.httpStatusCode === 404) return false;
+      this.fail(error, 'consultar');
+    }
+  }
+}
diff --git a/packages/storage/src/types.ts b/packages/storage/src/types.ts
new file mode 100644
index 0000000..98cce0a
--- /dev/null
+++ b/packages/storage/src/types.ts
@@ -0,0 +1,97 @@
+/**
+ * Onde os arquivos enviados para a base de conhecimento ficam guardados.
+ *
+ * Em produção: Cloudflare R2 (ou qualquer S3). Em desenvolvimento: uma pasta no disco, para
+ * `pnpm dev` funcionar sem conta em nuvem nenhuma. Quem usa (API e worker) só conhece esta
+ * interface — trocar de provedor não mexe no resto do código.
+ */
+export interface ObjectStorage {
+  /** Nome do driver, para log (`r2`, `s3`, `local`). */
+  readonly driver: string;
+  put(key: string, bytes: Uint8Array, options?: { contentType?: string }): Promise<void>;
+  get(key: string): Promise<Uint8Array>;
+  /** Apagar algo que não existe NÃO é erro (apagar é idempotente). */
+  delete(key: string): Promise<void>;
+  exists(key: string): Promise<boolean>;
+}
+
+export type StorageErrorCode =
+  /** A chave não existe (ou já foi apagada). */
+  | 'nao_encontrado'
+  /** Configuração ausente ou inválida (bucket, credenciais). */
+  | 'configuracao'
+  /** Falha de rede/serviço: vale tentar de novo. */
+  | 'indisponivel'
+  /** Chave fora do padrão (tentativa de sair da pasta, caracteres proibidos). */
+  | 'chave_invalida';
+
+export class StorageError extends Error {
+  constructor(
+    readonly code: StorageErrorCode,
+    message: string,
+    readonly retryable = false,
+    options: { cause?: unknown } = {},
+  ) {
+    super(message, options.cause === undefined ? undefined : { cause: options.cause });
+    this.name = 'StorageError';
+  }
+}
+
+/** Caracteres aceitos numa chave: pastas com letras, números, ponto, hífen e sublinhado. */
+const KEY_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$/;
+
+/**
+ * Valida a chave antes de qualquer acesso. Barra caminho absoluto, `..`, barras duplas e
+ * caracteres estranhos — no driver local isso seria sair da pasta e ler/escrever onde não deve.
+ */
+export function assertValidKey(key: string): string {
+  if (
+    !KEY_PATTERN.test(key) ||
+    key.includes('..') ||
+    key.includes('//') ||
+    key.endsWith('/') ||
+    key.endsWith('.')
+  ) {
+    throw new StorageError('chave_invalida', `Chave de arquivo inválida: "${key}".`);
+  }
+  return key;
+}
+
+/** Nome de arquivo seguro e legível (sem acento, espaço nem caractere especial). */
+export function slugifyFileName(fileName: string, fallback = 'arquivo'): string {
+  const normalized = fileName
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase();
+  // Só o nome do arquivo interessa: "../../etc/passwd" vira "passwd".
+  const baseName =
+    normalized
+      .split(/[\\/]+/)
+      .filter(Boolean)
+      .pop() ?? '';
+  const dot = baseName.lastIndexOf('.');
+  const extension = dot > 0 ? baseName.slice(dot + 1) : '';
+  const stem = dot > 0 ? baseName.slice(0, dot) : baseName;
+
+  const base = stem
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 80);
+  const safeExtension = extension.replace(/[^a-z0-9]/g, '').slice(0, 10);
+  return `${base || fallback}${safeExtension ? `.${safeExtension}` : ''}`;
+}
+
+/**
+ * Chave de um arquivo da base de conhecimento:
+ *   `tenants/<tenantId>/knowledge/<sourceId>/<nome-seguro>`
+ * O tenant no começo deixa óbvio de quem é o arquivo (e facilita apagar tudo de um cliente).
+ */
+export function buildKnowledgeObjectKey(input: {
+  tenantId: string;
+  sourceId: string;
+  fileName: string;
+}): string {
+  return assertValidKey(
+    `tenants/${input.tenantId}/knowledge/${input.sourceId}/${slugifyFileName(input.fileName)}`,
+  );
+}
