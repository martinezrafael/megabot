diff --git a/.env.example b/.env.example
index 9cca67e..61b1fbe 100644
--- a/.env.example
+++ b/.env.example
@@ -87,6 +87,23 @@ AI_EMBEDDING_MODEL=
 # AI_TIMEOUT_MS=30000              # tempo máximo por tentativa
 # AI_MAX_RETRIES=2                 # repetições internas de falhas transitórias
 # AI_BASE_URL=https://api.openai.com
+
+# --- Base de conhecimento (T2.2) ---
+# Onde ficam os ARQUIVOS enviados para a base. Em desenvolvimento, o disco já resolve.
+#   local (padrão): grava em STORAGE_LOCAL_DIR (não versione esta pasta)
+#   r2 | s3:        grava num bucket (Cloudflare R2 ou AWS S3)
+STORAGE_DRIVER=local
+STORAGE_LOCAL_DIR=.data/uploads
+# STORAGE_BUCKET=megabot-kb
+# STORAGE_ENDPOINT=https://<sua-conta>.r2.cloudflarestorage.com   # obrigatório na R2
+# STORAGE_REGION=auto
+# STORAGE_ACCESS_KEY_ID=
+# STORAGE_SECRET_ACCESS_KEY=
+# STORAGE_FORCE_PATH_STYLE=true
+# KNOWLEDGE_MAX_UPLOAD_MB=20              # tamanho máximo de um arquivo enviado
+# KNOWLEDGE_CHUNK_MAX_CHARS=1200          # tamanho máximo de um trecho
+# KNOWLEDGE_CHUNK_OVERLAP_CHARS=150       # sobreposição entre trechos vizinhos
+# KNOWLEDGE_EMBED_BATCH_SIZE=32           # trechos por chamada ao provedor de embeddings
 # WHATSAPP_API_TOKEN: token de acesso da Cloud API (Meta for Developers > WhatsApp > Configuração da API;
 #   em produção use um token de USUÁRIO DE SISTEMA, que não expira). Usado pelo worker para ENVIAR mensagens.
 #   Sem ele o worker não processa a fila whatsapp.outbound (os jobs ficam esperando). Nunca vai para o log.
