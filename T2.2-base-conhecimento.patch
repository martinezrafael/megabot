+const source = (over: Partial<KnowledgeSource> = {}): KnowledgeSource =>
+  ({
+    id: '11111111-1111-4111-8111-111111111111',
+    kind: 'upload',
+    title: 'Política.pdf',
+    status: 'ready',
+    progress: 100,
+    sourceUrl: null,
