diff --git a/apps/web/src/lib/auth-errors.ts b/apps/web/src/lib/auth-errors.ts
new file mode 100644
index 0000000..a29417c
--- /dev/null
+++ b/apps/web/src/lib/auth-errors.ts
@@ -0,0 +1,15 @@
+const MESSAGES: Record<string, string> = {
+  INVALID_EMAIL_OR_PASSWORD: 'E-mail ou senha incorretos.',
+  EMAIL_NOT_VERIFIED: 'Confirme seu e-mail antes de entrar. Verifique sua caixa de entrada.',
+  USER_ALREADY_EXISTS: 'Já existe uma conta com este e-mail.',
+  USER_ALREADY_EXISTS_USE_ANOTHER_EMAIL: 'Já existe uma conta com este e-mail.',
+  PASSWORD_TOO_SHORT: 'A senha deve ter pelo menos 8 caracteres.',
+  INVALID_EMAIL: 'E-mail inválido.',
+  INVALID_TOKEN: 'Link inválido ou expirado. Peça um novo.',
+};
+
+/** Traduz o código de erro do Better Auth para uma mensagem em português. */
+export function authErrorMessage(error: { code?: string; message?: string } | null | undefined) {
+  if (!error) return null;
+  return (error.code && MESSAGES[error.code]) || 'Algo deu errado. Tente novamente.';
+}
diff --git a/apps/web/src/lib/server-session.ts b/apps/web/src/lib/server-session.ts
new file mode 100644
index 0000000..39a43c6
--- /dev/null
+++ b/apps/web/src/lib/server-session.ts
@@ -0,0 +1,29 @@
+import { cookies } from 'next/headers';
+
+const API_URL = process.env.API_URL ?? process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:3000';
+
+export interface Me {
+  user: { id: string; email: string; name: string; image: string | null; emailVerified: boolean };
+  tenant: { id: string; role: 'OWNER' | 'ADMIN' | 'MEMBER' } | null;
+}
+
+/**
+ * Para Server Components: pergunta à API quem está logado, repassando o cookie
+ * do navegador. Retorna null se não houver sessão válida.
+ * (É a validação "de verdade" - o middleware só olha se o cookie existe.)
+ */
+export async function getMe(): Promise<Me | null> {
+  const cookieStore = await cookies();
+  const response = await fetch(`${API_URL}/me`, {
+    headers: { cookie: cookieStore.toString() },
+    cache: 'no-store',
+  });
+  if (response.status === 401) return null;
+  if (!response.ok) throw new Error(`Falha ao consultar /me: ${response.status}`);
+  return (await response.json()) as Me;
+}
+
+/** Só aceita caminhos internos (evita open redirect via ?next=). */
+export function safeNext(next: string | undefined): string {
+  return next && next.startsWith('/') && !next.startsWith('//') ? next : '/dashboard';
+}
diff --git a/apps/web/src/middleware.ts b/apps/web/src/middleware.ts
new file mode 100644
index 0000000..35786fc
--- /dev/null
+++ b/apps/web/src/middleware.ts
@@ -0,0 +1,20 @@
+import { NextResponse, type NextRequest } from 'next/server';
+import { getSessionCookie } from 'better-auth/cookies';
+
+/**
+ * Primeira barreira: se não existe cookie de sessão, manda para o login.
+ * Isto é só uma checagem rápida (otimista). A validação real acontece no
+ * Server Component via getMe() e na API (AuthGuard).
+ */
+export function middleware(request: NextRequest) {
+  if (!getSessionCookie(request)) {
+    const url = new URL('/sign-in', request.url);
+    url.searchParams.set('next', request.nextUrl.pathname);
+    return NextResponse.redirect(url);
+  }
+  return NextResponse.next();
+}
+
+export const config = {
+  matcher: ['/dashboard/:path*'],
+};
