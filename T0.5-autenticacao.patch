+
+export interface AppModuleOptions {
+  config: AppConfig;
+  mailer?: Mailer;
+}
+
+@Module({})
+export class AppModule {
+  static register(options: AppModuleOptions): DynamicModule {
+    return {
+      module: AppModule,
+      imports: [AuthModule.register(options)],
+      controllers: [HealthController, MeController],
