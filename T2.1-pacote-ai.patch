+        chatOk({ choices: [{ finish_reason: raw, message: { role: 'assistant', content: 'x' } }] }),
+      ]);
+      assert.equal(
+        (await t.provider.generate({ tenantId: TENANT, messages })).finishReason,
+        expected,
+      );
+    }
