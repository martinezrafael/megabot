+
+describe('OpenAiProvider.generate — erros, timeout e retentativa', () => {
+  const ask = (t: ReturnType<typeof make>) => t.provider.generate({ tenantId: TENANT, messages });
+
+  it('429 transitório: repete com backoff e dá certo', async () => {
