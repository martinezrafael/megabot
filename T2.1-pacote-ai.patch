new file mode 100644
index 0000000..6f11c01
--- /dev/null
+++ b/packages/ai/src/tools.ts
@@ -0,0 +1,91 @@
+import { z } from 'zod';
+import { AiError } from './errors';
+
+/**
+ * Ferramenta (tool/function) que o modelo pode chamar. `parameters` é um schema Zod: dele sai o JSON
+ * Schema enviado ao provedor E a validação (com tipos) dos argumentos que o modelo devolve.
+ */
+export interface ToolDefinition<
+  TName extends string = string,
+  TParams extends z.ZodObject = z.ZodObject,
+> {
+  readonly name: TName;
+  readonly description: string;
+  readonly parameters: TParams;
+}
+
+const TOOL_NAME = /^[A-Za-z0-9_-]{1,64}$/;
+
+/** Declara uma ferramenta. O nome vira tipo literal: é o que torna `toolCalls` tipado. */
+export function defineTool<const TName extends string, TParams extends z.ZodObject>(definition: {
+  name: TName;
+  description: string;
+  parameters: TParams;
+}): ToolDefinition<TName, TParams> {
+  if (!TOOL_NAME.test(definition.name)) {
+    throw new AiError(
+      `Nome de ferramenta inválido: "${definition.name}" (use letras, números, _ e -).`,
+      {
+        category: 'configuration',
+        retryable: false,
+      },
+    );
+  }
+  return definition;
+}
+
+/** Chamada de ferramenta devolvida pelo modelo, já validada: `arguments` tem o tipo do schema. */
+export type ToolCallOf<T extends ToolDefinition> =
+  T extends ToolDefinition<infer N, infer P>
+    ? { id: string; name: N; arguments: z.output<P> }
+    : never;
+
+/** Formato enviado ao provedor (JSON Schema, sem a chave `$schema`). */
+export function toolToJsonSchema(tool: ToolDefinition): Record<string, unknown> {
+  const schema = z.toJSONSchema(tool.parameters, { target: 'draft-7', io: 'input' }) as Record<
+    string,
+    unknown
+  >;
+  delete schema.$schema;
+  return schema;
+}
+
+/**
+ * Valida as chamadas brutas do modelo contra as ferramentas declaradas.
+ * Ferramenta desconhecida, JSON quebrado ou argumentos fora do schema → `AiError('invalid_response')`.
+ * A mensagem lista só caminhos/regras (nunca os valores: podem conter dados do cliente).
+ */
+export function parseToolCalls<const T extends readonly ToolDefinition[]>(
+  tools: T,
+  rawCalls: ReadonlyArray<{ id: string; name: string; arguments: string }>,
+): Array<ToolCallOf<T[number]>> {
+  return rawCalls.map((call) => {
+    const tool = tools.find((t) => t.name === call.name);
+    if (!tool) {
+      throw new AiError(`O modelo chamou uma ferramenta não declarada: "${call.name}".`, {
+        category: 'invalid_response',
+        retryable: false,
+      });
+    }
+    let json: unknown;
+    try {
+      json = call.arguments.trim() ? JSON.parse(call.arguments) : {};
+    } catch {
+      throw new AiError(`Argumentos da ferramenta "${call.name}" não são um JSON válido.`, {
+        category: 'invalid_response',
+        retryable: false,
+      });
+    }
+    const parsed = tool.parameters.safeParse(json);
+    if (!parsed.success) {
+      const problems = parsed.error.issues
+        .map((i) => `${i.path.join('.') || 'valor'}: ${i.message}`)
+        .join('; ');
+      throw new AiError(`Argumentos inválidos para a ferramenta "${call.name}": ${problems}`, {
+        category: 'invalid_response',
+        retryable: false,
+      });
+    }
+    return { id: call.id, name: call.name, arguments: parsed.data } as ToolCallOf<T[number]>;
+  });
+}
diff --git a/packages/ai/src/types.ts b/packages/ai/src/types.ts
new file mode 100644
index 0000000..d458631
--- /dev/null
+++ b/packages/ai/src/types.ts
@@ -0,0 +1,119 @@
+import type { ToolCallOf, ToolDefinition } from './tools';
+
+// ------------------------------------------------------------------ mensagens
+
+/** Chamada de ferramenta feita pelo assistente (para reenviar o histórico ao modelo). */
+export interface AssistantToolCall {
+  id: string;
+  name: string;
+  arguments: unknown;
+}
+
+export type ChatMessage =
+  | { role: 'system'; content: string }
+  | { role: 'user'; content: string }
+  | { role: 'assistant'; content: string | null; toolCalls?: readonly AssistantToolCall[] }
+  /** Resultado de uma ferramenta, respondendo a `toolCalls[].id`. */
+  | { role: 'tool'; toolCallId: string; content: string };
+
+// ------------------------------------------------------------------ uso e custo
+
+export interface TokenUsage {
+  inputTokens: number;
+  /** Parte de `inputTokens` servida do cache do provedor (mais barata). */
+  cachedInputTokens: number;
+  outputTokens: number;
+  totalTokens: number;
+}
+
+export type AiOperation = 'generate' | 'embed';
+
+/** Registro de UMA chamada lógica (inclui as repetições internas). Nunca contém o conteúdo. */
+export interface AiUsageRecord {
+  tenantId: string;
+  provider: string;
+  model: string;
+  operation: AiOperation;
+  outcome: 'ok' | 'error';
+  usage: TokenUsage;
+  /**
+   * Custo estimado em USD; `null` se o modelo não tem preço configurado ou o provedor não informou o
+   * uso. Uma chamada que gastou tokens mas devolveu algo inutilizável (outcome `error`) também tem custo.
+   */
+  costUsd: number | null;
+  latencyMs: number;
+  /** Chamadas HTTP feitas (1 = sem repetição). */
+  attempts: number;
+  errorCategory?: string;
+  /** `x-request-id` do provedor, para abrir chamado/suporte. */
+  requestId?: string | undefined;
+}
+
+/** Gancho para persistir/enviar o consumo (ex.: gravar por tenant). Falha aqui nunca derruba a chamada. */
+export type UsageRecorder = (record: AiUsageRecord) => void | Promise<void>;
+
+// ------------------------------------------------------------------ chat (LLM)
+
+export interface GenerateRequest<T extends readonly ToolDefinition[] = readonly []> {
+  /** Tenant dono da chamada: vai em todo log, métrica e registro de uso. */
+  tenantId: string;
+  messages: readonly ChatMessage[];
+  tools?: T;
+  /** `auto` (padrão): o modelo decide. `required`: deve chamar alguma. `{ name }`: força uma. */
+  toolChoice?: 'auto' | 'none' | 'required' | { name: T[number]['name'] };
+  /** Sobrescreve o modelo padrão da configuração. */
+  model?: string;
+  temperature?: number;
+  maxOutputTokens?: number;
+  /** Cancela a chamada (ex.: desligamento do worker). */
+  signal?: AbortSignal;
+}
+
+export type FinishReason = 'stop' | 'length' | 'tool_calls' | 'content_filter' | 'other';
+
+export interface GenerateResult<T extends readonly ToolDefinition[] = readonly []> {
+  /** Texto da resposta (pode ser `null` quando o modelo só chamou ferramentas). */
+  text: string | null;
+  /** Chamadas de ferramenta, validadas e tipadas conforme `tools`. */
+  toolCalls: Array<ToolCallOf<T[number]>>;
+  finishReason: FinishReason;
+  usage: TokenUsage;
+  costUsd: number | null;
+  /** Modelo que efetivamente respondeu. */
+  model: string;
+  requestId?: string | undefined;
+}
+
+export interface LLMProvider {
+  readonly name: string;
+  generate<const T extends readonly ToolDefinition[] = readonly []>(
+    request: GenerateRequest<T>,
+  ): Promise<GenerateResult<T>>;
+}
+
+// ------------------------------------------------------------------ embeddings
+
+export interface EmbedRequest {
+  tenantId: string;
+  /** Textos a vetorizar (1 a 2048). Textos vazios são recusados. */
+  input: readonly string[];
+  model?: string;
+  /** Reduz a dimensão do vetor (só modelos que suportam). Deve casar com o `vector(N)` do banco. */
+  dimensions?: number;
+  signal?: AbortSignal;
+}
+
+export interface EmbedResult {
+  /** Um vetor por texto, NA MESMA ORDEM de `input`. */
+  embeddings: number[][];
+  dimensions: number;
+  usage: TokenUsage;
+  costUsd: number | null;
+  model: string;
+  requestId?: string | undefined;
+}
+
+export interface EmbeddingProvider {
+  readonly name: string;
+  embed(request: EmbedRequest): Promise<EmbedResult>;
+}
