+import {
+  AiConfigError,
+  AiError,
+  FakeEmbeddingProvider,
+  FakeLlmProvider,
+  OpenAiProvider,
+  createOpenAiProvider,
+  defineTool,
+  loadAiConfig,
+} from '../src';
+
+const VALID = {
+  OPENAI_API_KEY: 'sk-test-123',
+  AI_CHAT_MODEL: 'modelo-chat',
+  AI_EMBEDDING_MODEL: 'modelo-emb',
+};
+
+describe('configuração (falha rápida)', () => {
+  it('lê o ambiente com padrões', () => {
+    const config = loadAiConfig(VALID);
+    assert.equal(config.baseUrl, 'https://api.openai.com');
+    assert.equal(config.timeoutMs, 30_000);
+    assert.equal(config.maxRetries, 2);
+    assert.deepEqual(config.pricing, {});
+    assert.equal(config.embeddingDimensions, undefined);
+  });
+
+  it('lê tudo, inclusive preços e dimensão', () => {
+    const config = loadAiConfig({
+      ...VALID,
+      AI_EMBEDDING_DIMENSIONS: '1536',
+      AI_TIMEOUT_MS: '5000',
+      AI_MAX_RETRIES: '0',
+      AI_BASE_URL: 'http://localhost:8080',
+      AI_PRICING_JSON: '{"modelo-chat":{"inputPerMillion":1,"outputPerMillion":2}}',
+    });
+    assert.equal(config.embeddingDimensions, 1536);
+    assert.equal(config.timeoutMs, 5000);
+    assert.equal(config.maxRetries, 0);
+    assert.equal(config.pricing['modelo-chat']?.outputPerMillion, 2);
+  });
+
+  it('lista TODOS os problemas de uma vez (strings vazias contam como ausentes)', () => {
+    assert.throws(
+      () => loadAiConfig({ OPENAI_API_KEY: '', AI_PRICING_JSON: '{', AI_TIMEOUT_MS: '5' }),
+      (e: unknown) => {
+        assert.ok(e instanceof AiConfigError);
+        const text = e.issues.join('\n');
+        for (const name of [
+          'OPENAI_API_KEY',
+          'AI_CHAT_MODEL',
+          'AI_EMBEDDING_MODEL',
+          'AI_TIMEOUT_MS',
+          'AI_PRICING_JSON',
+        ]) {
+          assert.ok(text.includes(name), `faltou ${name}`);
+        }
+        return true;
+      },
+    );
+  });
+
+  it('o erro nunca repete o valor da chave', () => {
+    assert.throws(
+      () => loadAiConfig({ ...VALID, OPENAI_API_KEY: 'sk-SEGREDO-123', AI_TIMEOUT_MS: 'xx' }),
+      (e: unknown) => e instanceof AiConfigError && !e.message.includes('sk-SEGREDO-123'),
+    );
+  });
+
+  it('createOpenAiProvider monta o provedor com a configuração', () => {
+    const provider = createOpenAiProvider(loadAiConfig(VALID));
+    assert.ok(provider instanceof OpenAiProvider);
+    assert.equal(provider.name, 'openai');
+  });
+});
+
+describe('dublês para testes', () => {
+  it('FakeLlmProvider: respostas roteirizadas, erros e registro das chamadas', async () => {
+    const tool = defineTool({ name: 'x', description: 'x', parameters: z.object({}) });
+    const fake = new FakeLlmProvider([
+      { text: 'primeira' },
+      new AiError('falha', { category: 'temporary', retryable: true }),
+    ]);
+    assert.equal(
+      (
+        await fake.generate({
+          tenantId: 't',
+          messages: [{ role: 'user', content: 'oi' }],
+          tools: [tool] as const,
+        })
+      ).text,
+      'primeira',
+    );
+    await assert.rejects(fake.generate({ tenantId: 't', messages: [] }), AiError);
+    assert.equal((await fake.generate({ tenantId: 't', messages: [] })).text, 'resposta de teste');
+    assert.equal(fake.calls.length, 3);
+  });
+
+  it('FakeEmbeddingProvider: determinístico, normalizado e com a dimensão pedida', async () => {
+    const fake = new FakeEmbeddingProvider(4);
+    const a = await fake.embed({ tenantId: 't', input: ['gato', 'cachorro'] });
+    const b = await fake.embed({ tenantId: 't', input: ['gato'], dimensions: 4 });
+    assert.deepEqual(a.embeddings[0], b.embeddings[0]);
+    assert.notDeepEqual(a.embeddings[0], a.embeddings[1]);
+    const norm = Math.sqrt(a.embeddings[0]!.reduce((s, v) => s + v * v, 0));
+    assert.ok(Math.abs(norm - 1) < 1e-9);
+    assert.equal(a.dimensions, 4);
+  });
+});
diff --git a/packages/ai/tests/helpers.ts b/packages/ai/tests/helpers.ts
new file mode 100644
index 0000000..10f8f00
--- /dev/null
+++ b/packages/ai/tests/helpers.ts
@@ -0,0 +1,113 @@
+import type { AiLogger, AiMetrics, LogFields } from '../src';
+
+export interface RecordedCall {
+  url: string;
+  method: string;
+  headers: Record<string, string>;
+  body: Record<string, unknown>;
+  signal: AbortSignal | undefined;
+}
+
+type Responder = Response | Error | ((call: RecordedCall) => Response | Promise<Response>);
+
+/** `fetch` falso: grava as chamadas e responde na ordem (a última resposta se repete). */
+export function fakeFetch(responders: Responder[]) {
+  const calls: RecordedCall[] = [];
+  const impl = (async (input: string | URL | Request, init?: RequestInit) => {
+    const call: RecordedCall = {
+      url: String(input),
+      method: init?.method ?? 'GET',
+      headers: { ...(init?.headers as Record<string, string>) },
+      body: JSON.parse(String(init?.body ?? '{}')) as Record<string, unknown>,
+      signal: init?.signal ?? undefined,
+    };
+    calls.push(call);
+    const next = responders[Math.min(calls.length - 1, responders.length - 1)]!;
+    if (next instanceof Error) throw next;
+    return typeof next === 'function' ? next(call) : next.clone();
+  }) as typeof fetch;
+  return { fetch: impl, calls };
+}
+
+export function json(body: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json', ...headers },
+  });
+}
+
+export function apiError(
+  status: number,
+  code: string | null,
+  message = 'mensagem do provedor com TRECHO-DO-PROMPT',
+  headers: Record<string, string> = {},
+): Response {
+  return json({ error: { message, type: 'error', code } }, status, headers);
+}
+
+export function chatOk(
+  over: Record<string, unknown> = {},
+  usage: Record<string, unknown> | null = {},
+) {
+  return json(
+    {
+      id: 'chatcmpl-1',
+      model: 'modelo-x-2026-01-01',
+      choices: [
+        { index: 0, finish_reason: 'stop', message: { role: 'assistant', content: 'Olá!' } },
+      ],
+      ...(usage === null
+        ? {}
+        : {
+            usage: {
+              prompt_tokens: 1000,
+              completion_tokens: 500,
+              total_tokens: 1500,
+              prompt_tokens_details: { cached_tokens: 0 },
+              ...usage,
+            },
+          }),
+      ...over,
+    },
+    200,
+    { 'x-request-id': 'req_abc' },
+  );
+}
+
+export function captureLogs() {
+  const lines: Array<{ level: string; fields: LogFields; message?: string }> = [];
+  const push = (level: string) => (fields: LogFields, message?: string) =>
+    void lines.push({ level, fields, ...(message ? { message } : {}) });
+  const logger: AiLogger = {
+    debug: push('debug'),
+    info: push('info'),
+    warn: push('warn'),
+    error: push('error'),
+  };
+  return { logger, lines };
+}
+
+export function captureMetrics() {
+  const increments: Array<{ name: string; labels: Record<string, string>; value: number }> = [];
+  const timings: Array<{ name: string; ms: number; labels: Record<string, string> }> = [];
+  const metrics: AiMetrics = {
+    increment: (name, labels = {}, value = 1) => void increments.push({ name, labels, value }),
+    timing: (name, ms, labels = {}) => void timings.push({ name, ms, labels }),
+  };
+  return { metrics, increments, timings };
+}
+
+/**
+ * Responde "nunca": só termina quando o sinal é abortado. Mantém um timer com referência para o
+ * processo de teste não encerrar enquanto espera (o `AbortSignal.timeout` do código não segura o
+ * processo vivo; em produção quem segura é o socket do `fetch`).
+ */
+export function hang(call: { signal: AbortSignal | undefined }): Promise<Response> {
+  return new Promise<Response>((_, reject) => {
+    const keepAlive = setTimeout(() => undefined, 60_000);
+    call.signal?.addEventListener('abort', () => {
+      clearTimeout(keepAlive);
+      reject(call.signal?.reason);
+    });
+  });
+}
