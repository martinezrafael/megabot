generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Tenant {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(255)
  slug                String               @unique @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// `active` | `suspended` (CHECK no banco). Tenant suspenso não aciona o agente (T1.5).
  status              String               @default("active") @db.VarChar(20)
  /// Limite de conversas (janelas de 24h abertas) por mês. NULL = sem limite (ADR 0011).
  conversationLimitPerMonth Int?           @map("conversation_limit_per_month")
  members             Membership[]
  whatsappConnections WhatsappConnection[]
  whatsappRateLimits  WhatsappRateLimit[]
  webhookEvents       WebhookEvent[]
  contacts            Contact[]

  @@map("tenants")
}

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String       @unique @db.VarChar(255)
  name          String       @db.VarChar(255)
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Tabelas de autenticação (Better Auth). São globais: não têm tenant_id e,
// por isso, não têm RLS. O vínculo usuário -> empresa fica em `memberships`.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// WhatsApp (T1.2). Ambas têm RLS (ver migration *_whatsapp_webhook).
// ---------------------------------------------------------------------------

/// Liga um número do WhatsApp (phone_number_id) a um tenant. O número é único no sistema inteiro.
model WhatsappConnection {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  phoneNumberId      String   @unique @map("phone_number_id")
  wabaId             String   @map("waba_id")
  displayPhoneNumber String?  @map("display_phone_number")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Token da Cloud API cifrado (envelope, ADR 0018). Nunca em texto puro.
  accessTokenEnvelope String?   @map("access_token_envelope")
  /// Id da KEK usada (para rotação).
  tokenKeyId          String?   @map("token_key_id")
  tokenUpdatedAt      DateTime? @map("token_updated_at")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_connections")
}

/// Balde de fichas do envio por número (T1.6): controla a vazão para não estourar o limite da Meta.
model WhatsappRateLimit {
  phoneNumberId String   @id @map("phone_number_id")
  tenantId      String   @map("tenant_id") @db.Uuid
  tokens        Float
  refilledAt    DateTime @map("refilled_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_rate_limits")
}

/// Caixa de entrada dos webhooks. `eventKey` é único por tenant: reenvio da Meta não duplica.
/// `kind` ∈ message | status | error e `processStatus` ∈ pending | processed | failed (CHECK no banco).
model WebhookEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  phoneNumberId String    @map("phone_number_id")
  eventKey      String    @map("event_key")
  kind          String
  wamid         String?
  status        String?
  /// Quando o evento aconteceu (hora da Meta), não quando chegou.
  eventAt       DateTime  @map("event_at") @db.Timestamptz(6)
  payload       Json
  processStatus String    @default("pending") @map("process_status")
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey])
  @@index([tenantId, processStatus, receivedAt])
  @@index([tenantId, wamid])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Conversas (T1.4). Todas com RLS (ver migration *_conversations).
// Regra (ADR 0010/0011): uma "conversa" é UMA janela de atendimento de 24h de um contato.
// O índice parcial "no máximo 1 conversa `open` por contato" só existe no SQL da migration.
// ---------------------------------------------------------------------------

/// Quem conversa com o tenant. `waId` = número do WhatsApp só com dígitos (E.164 sem "+").
model Contact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  waId        String   @map("wa_id")
  profileName String?  @map("profile_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]

  @@unique([tenantId, waId])
  @@unique([tenantId, id])
  @@map("contacts")
}

/// Uma janela de 24h. `status` ∈ open | expired (CHECK no banco). `windowExpiresAt` = última
/// mensagem RECEBIDA + 24h. Quem expira uma janela aberta é a varredura (ou a próxima mensagem).
model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  status          String    @default("open")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  windowExpiresAt DateTime  @map("window_expires_at") @db.Timestamptz(6)
  lastInboundAt   DateTime  @map("last_inbound_at") @db.Timestamptz(6)
  expiredAt       DateTime? @map("expired_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact  Contact   @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  messages Message[]

  @@unique([tenantId, id])
  @@index([tenantId, contactId, windowStartedAt])
  @@index([tenantId, status, windowExpiresAt])
  @@index([tenantId, windowStartedAt])
  @@map("conversations")
}

/// Mensagem recebida (`direction = inbound`, `sender = contact`) ou enviada (`bot` | `agent`).
/// `wamid` é único por tenant. `sentAt` = hora da Meta (recebidas) ou do envio (enviadas).
model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  direction      String
  sender         String
  type           String
  body           String?
  content        Json?
  wamid          String?
  status         String
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  sentAt         DateTime  @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact      Contact       @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, wamid])
  @@index([tenantId, conversationId, sentAt])
  @@index([tenantId, contactId, sentAt])
  @@map("messages")
}
