+
+      assert.equal(h.calls.length, 1);
+      assert.equal(h.calls[0]!.method, 'sendText');
+      assert.deepEqual(h.calls[0]!.input, { to: s.waId, body: 'Olá! Como posso ajudar?' });
+      const row = await getMessage(s.tenantId, s.out.id);
