{
  "name": "megabot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Rafael Molina Martinez",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @megabot/database db:generate",
    "db:migrate": "pnpm --filter @megabot/database db:migrate:deploy",
    "tunnel": "npx ngrok http 3000"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@megabot/eslint-config": "workspace:*",
    "@megabot/prettier-config": "workspace:*",
    "@megabot/swc-config": "workspace:*",
    "@megabot/tsconfig": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.11.10",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.0"
  }
}
