{
  "name": "@megabot/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../packages/config/swc/.swcrc -C module.type=commonjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "node --env-file=../../.env --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@megabot/database": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "better-auth": "^1.3.0",
    "express": "^5.3.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^7.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@megabot/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
