+  const row = await withTenant(tenantId, (tx) =>
+    tx.whatsappConnection.findFirst({
+      where: { tenantId, ...(phoneNumberId ? { phoneNumberId } : {}) },
+      orderBy: [{ createdAt: 'asc' }, { phoneNumberId: 'asc' }],
+      select: { phoneNumberId: true, accessTokenEnvelope: true },
+    }),
+  );
+  if (!row?.accessTokenEnvelope) return null;
+  const accessToken = await cipher.decrypt(
+    row.accessTokenEnvelope,
+    whatsappTokenAad(tenantId, row.phoneNumberId),
+  );
+  return { phoneNumberId: row.phoneNumberId, accessToken };
+}
diff --git a/packages/database/tests/integration/whatsapp-connection-token.test.ts b/packages/database/tests/integration/whatsapp-connection-token.test.ts
new file mode 100644
index 0000000..e3d5283
--- /dev/null
+++ b/packages/database/tests/integration/whatsapp-connection-token.test.ts
@@ -0,0 +1,157 @@
+import assert from 'node:assert/strict';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { after, before, describe, it } from 'node:test';
+import { prisma } from '../../src/client';
+import { withTenant } from '../../src/tenant-helper';
+import {
+  LocalKeyring,
+  PhoneNumberTakenError,
+  TenantNotFoundError,
+  TokenCipher,
+  TokenCryptoError,
+  connectWhatsappNumber,
+  getWhatsappAccessToken,
+  listWhatsappConnections,
+} from '../../src';
+
+const run = randomUUID().slice(0, 8);
+const cipher = new TokenCipher(new LocalKeyring({ k1: randomBytes(32) }, 'k1'));
+const TOKEN = `EAAG-${run}-token-que-nunca-pode-vazar`;
+let seq = 0;
+const pn = () => `${Date.now()}${String(++seq).padStart(3, '0')}`;
+
+/** Lê o envelope cru (RLS exige o tenant definido, mesmo em SQL puro). */
+const rawEnvelope = (tenantId: string, phoneNumberId: string) =>
+  withTenant(tenantId, async (tx) => {
+    const rows = await tx.$queryRaw<
+      Array<{ access_token_envelope: string }>
+    >`SELECT access_token_envelope FROM whatsapp_connections WHERE phone_number_id = ${phoneNumberId}`;
+    return rows;
+  });
+
+describe('conexão manual com token cifrado (Postgres real)', () => {
+  let a = '';
+  let b = '';
+
+  before(async () => {
+    const [ta, tb] = await Promise.all([
+      prisma.tenant.create({ data: { name: 'C A', slug: `c-a-${run}` } }),
+      prisma.tenant.create({ data: { name: 'C B', slug: `c-b-${run}` } }),
+    ]);
+    a = ta.id;
+    b = tb.id;
+  });
+
+  after(async () => {
+    await prisma.tenant.deleteMany({ where: { id: { in: [a, b] } } });
+    await prisma.$disconnect();
+  });
+
+  it('guarda o token CIFRADO (nunca em texto puro) e devolve só metadados', async () => {
+    const phoneNumberId = pn();
+    const { connection, created } = await connectWhatsappNumber(
+      a,
+      { phoneNumberId, wabaId: 'waba-1', accessToken: TOKEN },
+      cipher,
+    );
+    assert.equal(created, true);
+    assert.equal(connection.hasToken, true);
+    assert.equal(connection.tokenKeyId, 'k1');
+    assert.ok(!JSON.stringify(connection).includes(TOKEN));
+    assert.ok(!('accessTokenEnvelope' in connection));
+
+    const raw = await rawEnvelope(a, phoneNumberId);
+    assert.equal(raw.length, 1);
+    assert.ok(!raw[0]!.access_token_envelope.includes(TOKEN));
+    assert.ok(raw[0]!.access_token_envelope.startsWith('v1.k1.'));
+  });
+
+  it('o token decifra de volta para o tenant dono', async () => {
+    const phoneNumberId = pn();
+    await connectWhatsappNumber(a, { phoneNumberId, wabaId: 'w', accessToken: TOKEN }, cipher);
+    const found = await getWhatsappAccessToken(a, cipher);
+    assert.ok(found);
+    assert.equal(found.accessToken, TOKEN);
+  });
+
+  it('reconectar o mesmo número atualiza (created=false) e troca o token', async () => {
+    const phoneNumberId = pn();
+    await connectWhatsappNumber(b, { phoneNumberId, wabaId: 'w1', accessToken: 'um' }, cipher);
+    const again = await connectWhatsappNumber(
+      b,
+      { phoneNumberId, wabaId: 'w2', displayPhoneNumber: '+55 11 99999-0000', accessToken: 'dois' },
+      cipher,
+    );
+    assert.equal(again.created, false);
+    assert.equal(again.connection.wabaId, 'w2');
+    assert.equal((await getWhatsappAccessToken(b, cipher))?.accessToken, 'dois');
+    assert.equal((await listWhatsappConnections(b)).length, 1);
+  });
+
+  it('número de OUTRO tenant é recusado e o token do dono não muda', async () => {
+    const phoneNumberId = pn();
+    await connectWhatsappNumber(a, { phoneNumberId, wabaId: 'w', accessToken: 'do-a' }, cipher);
+    await assert.rejects(
+      connectWhatsappNumber(b, { phoneNumberId, wabaId: 'w', accessToken: 'do-b' }, cipher),
+      PhoneNumberTakenError,
+    );
+    const list = await listWhatsappConnections(a);
+    assert.ok(list.some((c) => c.phoneNumberId === phoneNumberId));
+    const owner = await getWhatsappAccessToken(a, cipher);
+    assert.notEqual(owner?.accessToken, 'do-b');
+  });
+
+  it('tenant inexistente → TenantNotFoundError', async () => {
+    await assert.rejects(
+      connectWhatsappNumber(
+        randomUUID(),
+        { phoneNumberId: pn(), wabaId: 'w', accessToken: 'x' },
+        cipher,
+      ),
+      TenantNotFoundError,
+    );
+  });
+
+  it('envelope copiado para OUTRO tenant não abre (AAD amarra tenant e número)', async () => {
+    const phoneNumberId = pn();
+    await connectWhatsappNumber(a, { phoneNumberId, wabaId: 'w', accessToken: TOKEN }, cipher);
+    const [row] = await rawEnvelope(a, phoneNumberId);
+    // Simula alguém com acesso ao banco copiando o envelope para a linha de OUTRO tenant.
+    const victim = await prisma.tenant.create({ data: { name: 'C D', slug: `c-d-${run}` } });
+    try {
+      const other = pn();
+      await connectWhatsappNumber(
+        victim.id,
+        { phoneNumberId: other, wabaId: 'w', accessToken: 'x' },
+        cipher,
+      );
+      await withTenant(
+        victim.id,
+        (tx) =>
+          tx.$executeRaw`UPDATE whatsapp_connections SET access_token_envelope = ${row!.access_token_envelope} WHERE phone_number_id = ${other}`,
+      );
+      await assert.rejects(
+        getWhatsappAccessToken(victim.id, cipher),
+        (e: unknown) => e instanceof TokenCryptoError && e.code === 'decrypt_failed',
+      );
+    } finally {
+      await prisma.tenant.delete({ where: { id: victim.id } });
+    }
+  });
+
+  it('conexão antiga sem token → null (cai no token global do worker)', async () => {
+    const t = await prisma.tenant.create({ data: { name: 'C C', slug: `c-c-${run}` } });
+    try {
+      await withTenant(t.id, (tx) =>
+        tx.whatsappConnection.create({
+          data: { tenantId: t.id, phoneNumberId: pn(), wabaId: 'w' },
+        }),
+      );
+      assert.equal(await getWhatsappAccessToken(t.id, cipher), null);
+      const [view] = await listWhatsappConnections(t.id);
+      assert.equal(view?.hasToken, false);
+    } finally {
+      await prisma.tenant.delete({ where: { id: t.id } });
+    }
+  });
+});
diff --git a/packages/database/tests/token-crypto.test.ts b/packages/database/tests/token-crypto.test.ts
new file mode 100644
index 0000000..23e1688
--- /dev/null
+++ b/packages/database/tests/token-crypto.test.ts
@@ -0,0 +1,121 @@
+import assert from 'node:assert/strict';
+import { randomBytes } from 'node:crypto';
+import { describe, it } from 'node:test';
+import {
+  LocalKeyring,
+  TokenCipher,
+  TokenCryptoError,
+  createTokenCipherFromEnv,
+  whatsappTokenAad,
+} from '../src/token-crypto';
+
+const key = () => randomBytes(32);
+const cipherWith = (keys: Record<string, Buffer>, active: string) =>
+  new TokenCipher(new LocalKeyring(keys, active));
+const SECRET = 'EAAG-segredo-super-secreto-123';
+const AAD = whatsappTokenAad('11111111-1111-4111-8111-111111111111', '1065403522');
+
+describe('criptografia de envelope (T1.7)', () => {
+  it('cifra e decifra (ida e volta) e o envelope não contém o texto puro', async () => {
+    const c = cipherWith({ k1: key() }, 'k1');
+    const { envelope, keyId } = await c.encrypt(SECRET, AAD);
+    assert.equal(keyId, 'k1');
+    assert.ok(!envelope.includes(SECRET));
+    assert.ok(!Buffer.from(envelope).toString('base64').includes(SECRET));
+    assert.equal(await c.decrypt(envelope, AAD), SECRET);
+  });
+
+  it('cada cifragem é diferente (DEK e iv aleatórios)', async () => {
+    const c = cipherWith({ k1: key() }, 'k1');
+    const a = await c.encrypt(SECRET, AAD);
+    const b = await c.encrypt(SECRET, AAD);
+    assert.notEqual(a.envelope, b.envelope);
+  });
+
+  it('AAD diferente (outro tenant/número) falha', async () => {
+    const c = cipherWith({ k1: key() }, 'k1');
+    const { envelope } = await c.encrypt(SECRET, AAD);
+    await assert.rejects(
+      c.decrypt(envelope, whatsappTokenAad('22222222-2222-4222-8222-222222222222', '1065403522')),
+      (e: unknown) => e instanceof TokenCryptoError && e.code === 'decrypt_failed',
+    );
+  });
+
+  it('adulteração de qualquer parte é detectada, e o erro não vaza o segredo', async () => {
+    const c = cipherWith({ k1: key() }, 'k1');
+    const { envelope } = await c.encrypt(SECRET, AAD);
+    const parts = envelope.split('.');
+    for (const index of [2, 3, 4, 5]) {
+      const copy = [...parts];
+      const buf = Buffer.from(copy[index] as string, 'base64url');
+      buf[0] = (buf[0] as number) ^ 0xff;
+      copy[index] = buf.toString('base64url');
+      await assert.rejects(c.decrypt(copy.join('.'), AAD), (e: unknown) => {
+        assert.ok(e instanceof TokenCryptoError);
+        assert.ok(!e.message.includes(SECRET));
+        return true;
+      });
+    }
+  });
+
+  it('chave errada falha; formato desconhecido falha', async () => {
+    const a = cipherWith({ k1: key() }, 'k1');
+    const b = cipherWith({ k1: key() }, 'k1');
+    const { envelope } = await a.encrypt(SECRET, AAD);
+    await assert.rejects(b.decrypt(envelope, AAD), { code: 'decrypt_failed' });
+    await assert.rejects(a.decrypt('lixo', AAD), { code: 'invalid_envelope' });
+    await assert.rejects(a.decrypt(envelope.replace(/^v1/, 'v9'), AAD), {
+      code: 'invalid_envelope',
+    });
+  });
+
+  it('rotação: envelope antigo continua legível; novos usam a chave ativa', async () => {
+    const k1 = key();
+    const k2 = key();
+    const old = await cipherWith({ k1 }, 'k1').encrypt(SECRET, AAD);
+    const rotated = cipherWith({ k1, k2 }, 'k2');
+    assert.equal(await rotated.decrypt(old.envelope, AAD), SECRET);
+    const fresh = await rotated.encrypt(SECRET, AAD);
+    assert.equal(fresh.keyId, 'k2');
+    assert.equal(TokenCipher.keyIdOf(fresh.envelope), 'k2');
+    assert.equal(TokenCipher.keyIdOf(old.envelope), 'k1');
+    // Sem a chave antiga no chaveiro, o envelope antigo não abre.
+    await assert.rejects(cipherWith({ k2 }, 'k2').decrypt(old.envelope, AAD), {
+      code: 'unknown_key',
+    });
+  });
+
+  it('valida o chaveiro: tamanho da chave, id inválido, chave ativa ausente', () => {
+    assert.throws(() => new LocalKeyring({ k1: randomBytes(16) }, 'k1'), /32 bytes/);
+    assert.throws(() => new LocalKeyring({ 'a.b': key() }, 'a.b'), /Id de chave/);
+    assert.throws(() => new LocalKeyring({ k1: key() }, 'k2'), /chave ativa/);
+  });
+
+  it('createTokenCipherFromEnv: lê o ambiente', async () => {
+    assert.equal(createTokenCipherFromEnv({}), null);
+    const k = randomBytes(32).toString('base64');
+    const one = createTokenCipherFromEnv({ TOKEN_ENCRYPTION_KEYS: `a:${k}` });
+    assert.equal(one?.activeKeyId, 'a');
+    const two = createTokenCipherFromEnv({
+      TOKEN_ENCRYPTION_KEYS: `a:${k},b:${randomBytes(32).toString('base64')}`,
+      TOKEN_ENCRYPTION_ACTIVE_KEY_ID: 'b',
+    });
+    assert.equal(two?.activeKeyId, 'b');
+    assert.throws(
+      () =>
+        createTokenCipherFromEnv({
+          TOKEN_ENCRYPTION_KEYS: `a:${k},b:${randomBytes(32).toString('base64')}`,
+        }),
+      /TOKEN_ENCRYPTION_ACTIVE_KEY_ID/,
+    );
+    assert.throws(
+      () => createTokenCipherFromEnv({ TOKEN_ENCRYPTION_KEYS: 'semformato' }),
+      /id:chave/,
+    );
+    assert.throws(
+      () => createTokenCipherFromEnv({ TOKEN_ENCRYPTION_KEYS: `a:${k},a:${k}` }),
+      /repetido/,
+    );
+    assert.throws(() => createTokenCipherFromEnv({ TOKEN_ENCRYPTION_KEYS: 'a:curta' }), /32 bytes/);
+  });
+});
