+
+function toView(row: {
+  id: string;
+  tenantId: string;
+  phoneNumberId: string;
+  wabaId: string;
+  displayPhoneNumber: string | null;
+  accessTokenEnvelope: string | null;
+  tokenKeyId: string | null;
+  tokenUpdatedAt: Date | null;
+  createdAt: Date;
