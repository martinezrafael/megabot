diff --git a/apps/api/src/admin/admin-whatsapp.controller.ts b/apps/api/src/admin/admin-whatsapp.controller.ts
new file mode 100644
index 0000000..1f597ec
--- /dev/null
+++ b/apps/api/src/admin/admin-whatsapp.controller.ts
@@ -0,0 +1,137 @@
+import {
+  BadRequestException,
+  Body,
+  Controller,
+  Get,
+  Header,
+  HttpCode,
+  Inject,
+  Post,
+  Query,
+  Req,
+  Res,
+  UseGuards,
+} from '@nestjs/common';
+import {
+  ApiBody,
+  ApiCookieAuth,
+  ApiCreatedResponse,
+  ApiOkResponse,
+  ApiOperation,
+  ApiQuery,
+  ApiResponse,
+  ApiTags,
+} from '@nestjs/swagger';
+import type { Response } from 'express';
+import { z } from 'zod';
+import type { AuthedRequest } from '../auth/auth.context';
+import { ErrorResponseDto } from '../common/error-response.dto';
+import {
+  ConnectWhatsappNumberBodyDto,
+  ConnectWhatsappNumberResponseDto,
+  WhatsappConnectionDto,
+} from './admin-whatsapp.dto';
+import { AdminWhatsappService } from './admin-whatsapp.service';
+import { PlatformAdminGuard } from './platform-admin.guard';
+
+const connectBody = z.strictObject({
+  tenantId: z.uuid(),
+  phoneNumberId: z.string().regex(/^\d{1,32}$/, 'use só dígitos (até 32)'),
+  wabaId: z
+    .string()
+    .trim()
+    .regex(/^[\w-]{1,64}$/, 'id inválido'),
+  accessToken: z.string().min(20, 'token curto demais').max(2048, 'token longo demais'),
+  displayPhoneNumber: z.string().trim().min(1).max(32).optional(),
+});
+
+const listQuery = z.object({ tenantId: z.uuid() });
+
+function parseOrBadRequest<T>(schema: z.ZodType<T>, value: unknown): T {
+  const result = schema.safeParse(value);
+  if (!result.success) {
+    // Só caminho + mensagem do Zod (nunca o valor recebido: o corpo tem o token).
+    throw new BadRequestException(
+      result.error.issues.map((i) => `${i.path.join('.') || 'valor'}: ${i.message}`).join('; '),
+    );
+  }
+  return result.data;
+}
+
+/**
+ * Conexão manual de número do WhatsApp (T1.7). Só administradores da plataforma.
+ * O token de acesso é cifrado (envelope) antes de ir ao banco e NUNCA volta em nenhuma resposta.
+ */
+@ApiTags('admin')
+@ApiCookieAuth('session')
+@UseGuards(PlatformAdminGuard)
+@Controller('admin/whatsapp/connections')
+@ApiResponse({ status: 401, type: ErrorResponseDto, description: 'Sem sessão válida' })
+@ApiResponse({
+  status: 403,
+  type: ErrorResponseDto,
+  description: 'Não é administrador da plataforma',
+})
+export class AdminWhatsappController {
+  constructor(@Inject(AdminWhatsappService) private readonly service: AdminWhatsappService) {}
+
+  @Post()
+  @HttpCode(201)
+  @Header('Cache-Control', 'no-store')
+  @ApiOperation({
+    summary:
+      'Conectar (ou atualizar) o número do WhatsApp de uma empresa, guardando o token cifrado',
+  })
+  @ApiBody({ type: ConnectWhatsappNumberBodyDto })
+  @ApiCreatedResponse({
+    type: ConnectWhatsappNumberResponseDto,
+    description: '`created=true` (nova) ou `created=false` (atualizada; o status HTTP é 200)',
+  })
+  @ApiResponse({ status: 400, type: ErrorResponseDto, description: 'Corpo inválido' })
+  @ApiResponse({ status: 404, type: ErrorResponseDto, description: 'Empresa inexistente' })
+  @ApiResponse({
+    status: 409,
+    type: ErrorResponseDto,
+    description: 'O número já está conectado a OUTRA empresa',
+  })
+  @ApiResponse({
+    status: 503,
+    type: ErrorResponseDto,
+    description: 'Criptografia de tokens não configurada no servidor',
+  })
+  async connect(
+    @Body() body: unknown,
+    @Req() request: AuthedRequest,
+    @Res({ passthrough: true }) response: Response,
+  ): Promise<ConnectWhatsappNumberResponseDto> {
+    const input = parseOrBadRequest(connectBody, body);
+    const result = await this.service.connect(input, request.auth?.user.email ?? 'desconhecido');
+    if (!result.created) response.status(200);
+    return {
+      created: result.created,
+      connection: {
+        ...result.connection,
+        tokenUpdatedAt: result.connection.tokenUpdatedAt?.toISOString() ?? null,
+        createdAt: result.connection.createdAt.toISOString(),
+        updatedAt: result.connection.updatedAt.toISOString(),
+      },
+    };
+  }
+
+  @Get()
+  @Header('Cache-Control', 'no-store')
+  @ApiOperation({ summary: 'Conexões de uma empresa (sem o token)' })
+  @ApiQuery({ name: 'tenantId', required: true, type: String })
+  @ApiOkResponse({ type: [WhatsappConnectionDto] })
+  @ApiResponse({ status: 400, type: ErrorResponseDto, description: 'tenantId inválido' })
+  async list(@Query() query: Record<string, unknown>): Promise<WhatsappConnectionDto[]> {
+    const { tenantId } = parseOrBadRequest(listQuery, query);
+    const rows = await this.service.list(tenantId);
+    return rows.map((c) => ({
+      ...c,
+      tokenUpdatedAt: c.tokenUpdatedAt?.toISOString() ?? null,
+      createdAt: c.createdAt.toISOString(),
+      updatedAt: c.updatedAt.toISOString(),
+    }));
+  }
+}
diff --git a/apps/api/src/admin/admin-whatsapp.dto.ts b/apps/api/src/admin/admin-whatsapp.dto.ts
new file mode 100644
index 0000000..9956d8a
--- /dev/null
+++ b/apps/api/src/admin/admin-whatsapp.dto.ts
@@ -0,0 +1,69 @@
+import { ApiProperty } from '@nestjs/swagger';
+
+/** Corpo de POST /admin/whatsapp/connections. O token só ENTRA; nenhuma resposta o devolve. */
+export class ConnectWhatsappNumberBodyDto {
+  @ApiProperty({ type: String, format: 'uuid', description: 'Empresa (tenant) dona do número' })
+  tenantId!: string;
+  @ApiProperty({
+    type: String,
+    example: '106540352242922',
+    description: '`phone_number_id` da Meta (só dígitos)',
+  })
+  phoneNumberId!: string;
+  @ApiProperty({
+    type: String,
+    example: '102290129340398',
+    description: 'WhatsApp Business Account id',
+  })
+  wabaId!: string;
+  @ApiProperty({
+    type: String,
+    format: 'password',
+    writeOnly: true,
+    description:
+      'Token de acesso da Cloud API (use um token de usuário de sistema). Guardado cifrado; nunca é devolvido nem logado.',
+  })
+  accessToken!: string;
+  @ApiProperty({ type: String, required: false, example: '+55 11 99999-0000' })
+  displayPhoneNumber?: string;
+}
+
+export class WhatsappConnectionDto {
+  @ApiProperty({ type: String, format: 'uuid' })
+  id!: string;
+  @ApiProperty({ type: String, format: 'uuid' })
+  tenantId!: string;
+  @ApiProperty({ type: String })
+  phoneNumberId!: string;
+  @ApiProperty({ type: String })
+  wabaId!: string;
+  @ApiProperty({ type: String, nullable: true })
+  displayPhoneNumber!: string | null;
+  @ApiProperty({
+    type: Boolean,
+    description: 'Há token cifrado guardado (o valor nunca é exibido)',
+  })
+  hasToken!: boolean;
+  @ApiProperty({
+    type: String,
+    nullable: true,
+    description: 'Id da chave (KEK) que protege o token',
+  })
+  tokenKeyId!: string | null;
+  @ApiProperty({ type: String, format: 'date-time', nullable: true })
+  tokenUpdatedAt!: string | null;
+  @ApiProperty({ type: String, format: 'date-time' })
+  createdAt!: string;
+  @ApiProperty({ type: String, format: 'date-time' })
+  updatedAt!: string;
+}
+
+export class ConnectWhatsappNumberResponseDto {
+  @ApiProperty({
+    type: Boolean,
+    description: 'true = conexão nova; false = atualizou uma existente',
+  })
+  created!: boolean;
+  @ApiProperty({ type: WhatsappConnectionDto })
+  connection!: WhatsappConnectionDto;
+}
diff --git a/apps/api/src/admin/admin-whatsapp.service.ts b/apps/api/src/admin/admin-whatsapp.service.ts
new file mode 100644
index 0000000..b89780c
--- /dev/null
+++ b/apps/api/src/admin/admin-whatsapp.service.ts
@@ -0,0 +1,101 @@
+import {
+  ConflictException,
+  Inject,
+  Injectable,
+  NotFoundException,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import {
+  PhoneNumberTakenError,
+  TenantNotFoundError,
+  connectWhatsappNumber,
+  listWhatsappConnections,
+  type WhatsappConnectionView,
+} from '@megabot/database';
+import { PinoLogger } from 'nestjs-pino';
+import type { AppConfig } from '../config';
+import { APP_CONFIG } from '../config.tokens';
+import { createLogMetrics } from '../whatsapp/log-metrics';
+
+export interface ConnectInput {
+  tenantId: string;
+  phoneNumberId: string;
+  wabaId: string;
+  accessToken: string;
+  displayPhoneNumber?: string | undefined;
+}
+
+export const CONNECTION_METRIC = {
+  /** Rótulos: tenant_id, outcome (created|updated|conflict|tenant_not_found). */
+  connect: 'whatsapp_connection_admin_total',
+} as const;
+
+@Injectable()
+export class AdminWhatsappService {
+  constructor(
+    @Inject(APP_CONFIG) private readonly config: AppConfig,
+    @Inject(PinoLogger) private readonly logger: PinoLogger,
+  ) {}
+
+  async connect(
+    input: ConnectInput,
+    actorEmail: string,
+  ): Promise<{ created: boolean; connection: WhatsappConnectionView }> {
+    const cipher = this.config.tokenCipher;
+    if (!cipher) {
+      throw new ServiceUnavailableException(
+        'Criptografia de tokens não configurada (defina TOKEN_ENCRYPTION_KEYS).',
+      );
+    }
+    const metrics = createLogMetrics(this.logger);
+    const { tenantId } = input;
+    // Nunca logamos o token (nem o corpo da requisição): só ids e o resultado.
+    const base = { tenant_id: tenantId, phone_number_id: input.phoneNumberId, actor: actorEmail };
+
+    try {
+      const result = await connectWhatsappNumber(
+        tenantId,
+        {
+          phoneNumberId: input.phoneNumberId,
+          wabaId: input.wabaId,
+          accessToken: input.accessToken,
+          ...(input.displayPhoneNumber ? { displayPhoneNumber: input.displayPhoneNumber } : {}),
+        },
+        cipher,
+      );
+      const outcome = result.created ? 'created' : 'updated';
+      metrics.increment(CONNECTION_METRIC.connect, { tenant_id: tenantId, outcome });
+      this.logger.info(
+        {
+          event: 'whatsapp.connection.admin',
+          ...base,
+          outcome,
+          token_key_id: result.connection.tokenKeyId,
+        },
+        result.created ? 'Número do WhatsApp conectado' : 'Conexão do WhatsApp atualizada',
+      );
+      return result;
+    } catch (error) {
+      if (error instanceof PhoneNumberTakenError) {
+        metrics.increment(CONNECTION_METRIC.connect, { tenant_id: tenantId, outcome: 'conflict' });
+        this.logger.warn(
+          { event: 'whatsapp.connection.admin', ...base, outcome: 'conflict' },
+          'Número já conectado a outro tenant',
+        );
+        throw new ConflictException(error.message);
+      }
+      if (error instanceof TenantNotFoundError) {
+        metrics.increment(CONNECTION_METRIC.connect, {
+          tenant_id: tenantId,
+          outcome: 'tenant_not_found',
+        });
+        throw new NotFoundException(error.message);
+      }
+      throw error;
+    }
+  }
+
+  list(tenantId: string): Promise<WhatsappConnectionView[]> {
+    return listWhatsappConnections(tenantId);
+  }
+}
